#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════
# Sage CLI
#
# Usage:
#   sage new <name>     Create a new project with Sage
#   sage init           Add Sage to the current directory
#   sage update         Regenerate platform files
#   sage upgrade        Update Sage to the latest version
#   sage help           Show available commands
# ═══════════════════════════════════════════════════════════════
set -euo pipefail

# ── Colors ──
BOLD='\033[1m'
GREEN='\033[32m'
YELLOW='\033[33m'
CYAN='\033[36m'
RED='\033[31m'
DIM='\033[2m'
RESET='\033[0m'

# ── Rich output helpers ──
SAGE_START_TIME=""
STEP_START_TIME=""

# macOS date doesn't support %N — outputs literal "N" instead of failing
_sage_now() {
  local t
  t=$(date +%s%N 2>/dev/null || date +%s)
  # Strip non-digits (macOS outputs "1774343489N")
  t="${t//[!0-9]/}"
  # If length <= 10, it's seconds only — no nanosecond support
  if [ ${#t} -le 10 ]; then
    echo "${t}000000000"
  else
    echo "$t"
  fi
}

timer_start() { SAGE_START_TIME=$(_sage_now); }
step_start()  { STEP_START_TIME=$(_sage_now); }

elapsed_ms() {
  local now start
  now=$(_sage_now)
  start="${1:-$STEP_START_TIME}"
  echo $(( (now - start) / 1000000 ))
}

fmt_time() {
  local ms="$1"
  if [ "$ms" -lt 1000 ]; then
    echo "${ms}ms"
  else
    local s=$((ms / 1000))
    local rem=$((ms % 1000 / 100))
    echo "${s}.${rem}s"
  fi
}

section() {
  echo ""
  echo -e "  ${BOLD}┌─ $1${RESET}"
}

section_end() {
  echo -e "  ${BOLD}│${RESET}"
}

step_ok() {
  local ms
  ms=$(elapsed_ms "$STEP_START_TIME")
  local time_str
  time_str=$(fmt_time "$ms")
  printf "  │  ${GREEN}✓${RESET} %-42s ${DIM}%s${RESET}\n" "$1" "$time_str"
  step_start
}

step_ok_notimed() {
  echo -e "  │  ${GREEN}✓${RESET} $1"
}

step_warn() {
  echo -e "  │  ${YELLOW}⚠${RESET} $1"
}

step_fail() {
  echo -e "  │  ${RED}✗${RESET} $1"
}

step_info() {
  echo -e "  │  ${CYAN}↻${RESET} $1"
}

sage_complete() {
  local total_ms
  total_ms=$(elapsed_ms "$SAGE_START_TIME")
  local time_str
  time_str=$(fmt_time "$total_ms")
  echo -e "  ${BOLD}└─ Complete${RESET}  ${DIM}${time_str} total${RESET}"
  echo ""
}

spin() {
  local pid=$1 msg="${2:-Working...}"
  # Non-interactive: just wait silently
  if [ ! -t 1 ]; then
    wait "$pid" 2>/dev/null
    return $?
  fi
  local chars='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
  while kill -0 "$pid" 2>/dev/null; do
    for i in $(seq 0 $((${#chars} - 1))); do
      kill -0 "$pid" 2>/dev/null || break
      printf "\r  ${DIM}${chars:$i:1} %s${RESET}" "$msg"
      sleep 0.08
    done
  done
  printf "\r                                                       \r"
  wait "$pid" 2>/dev/null
  return $?
}

# ── Portable realpath ──
# Resolves a path through symlink chains. GNU readlink supports `-f`;
# BSD/macOS readlink does not (only follows one level). Falls back to
# Python `os.path.realpath`, then to a manual while-loop. Used to
# locate the actual framework checkout when `bin/sage` is invoked
# through a symlink (e.g., ~/.local/bin/sage → repo bin/sage, brew
# shim, npm-global wrapper).
_realpath() {
  local target="$1"
  [ -n "$target" ] || return 1
  if readlink -f / >/dev/null 2>&1; then
    readlink -f "$target" 2>/dev/null && return 0
  fi
  if command -v python3 >/dev/null 2>&1; then
    python3 -c "import os,sys; print(os.path.realpath(sys.argv[1]))" "$target" 2>/dev/null && return 0
  fi
  # Manual fallback: walk symlinks one level at a time.
  local current="$target"
  local n=0
  while [ -L "$current" ] && [ $n -lt 32 ]; do
    local next
    next=$(readlink "$current" 2>/dev/null) || break
    case "$next" in
      /*) current="$next" ;;
      *)  current="$(dirname "$current")/$next" ;;
    esac
    n=$((n + 1))
  done
  if [ -d "$current" ]; then
    (cd "$current" 2>/dev/null && pwd -P)
  else
    (cd "$(dirname "$current")" 2>/dev/null && printf "%s/%s\n" "$(pwd -P)" "$(basename "$current")")
  fi
}

# ── Resolve framework source ──
# Priority:
#   1. script's own directory (resolved through symlinks via _realpath)
#   2. SAGE_HOME env
#   3. ~/.sage/framework
#
# Validation: framework root must contain `core/` AND `skills/`. If the
# resolved-symlink layout fails validation (e.g., brew/npm-global
# packaged shim with no sibling `core/`), fall through to global-install
# candidates rather than trusting an invalid layout.
resolve_framework() {
  local script_path resolved script_dir parent_dir
  script_path="${BASH_SOURCE[0]}"
  resolved=$(_realpath "$script_path" 2>/dev/null || printf "%s" "$script_path")
  script_dir="$(cd "$(dirname "$resolved")" 2>/dev/null && pwd -P)"
  parent_dir="$(dirname "$script_dir")"

  if [ -d "$parent_dir/core" ] && [ -d "$parent_dir/skills" ]; then
    SAGE_FRAMEWORK="$parent_dir"
    return
  fi

  # Global install
  if [ -n "${SAGE_HOME:-}" ] && [ -d "$SAGE_HOME/framework/core" ]; then
    SAGE_FRAMEWORK="$SAGE_HOME/framework"
    return
  fi

  if [ -d "$HOME/.sage/framework/core" ]; then
    SAGE_FRAMEWORK="$HOME/.sage/framework"
    return
  fi

  echo -e "${RED}❌ Cannot find Sage framework.${RESET}"
  echo ""
  echo "  Install Sage first:"
  echo "    curl -fsSL https://raw.githubusercontent.com/xoai/sage/main/install.sh | bash"
  exit 1
}

# ── Resolve framework profile ──
# Reads `.sage/profile` from the framework root (NOT project root) to
# determine whether aggressive self-host defaults apply or upstream-
# friendly conservative defaults. See ADR-2 for the contract.
#
# Output sets two globals:
#   SAGE_PROFILE       — "self-host" | "upstream"
#   SAGE_PROFILE_SOURCE — absolute path to the file that produced the
#                         decision, or "(default: upstream)" when no
#                         file exists / framework root failed validation.
#
# Cached: read once per `sage` invocation.
resolve_profile() {
  [ -n "${SAGE_PROFILE:-}" ] && return 0
  SAGE_PROFILE="upstream"
  SAGE_PROFILE_SOURCE="(default: upstream)"

  # Validation guard: framework root must look like a checkout, not a
  # packaged shim. If validation fails, stay on upstream default —
  # safer than trusting an unknown layout's `.sage/profile`.
  if [ ! -d "${SAGE_FRAMEWORK:-}/core" ] || [ ! -d "${SAGE_FRAMEWORK:-}/skills" ]; then
    return 0
  fi

  local profile_file="$SAGE_FRAMEWORK/.sage/profile"
  [ -f "$profile_file" ] || return 0

  local value
  value=$(awk -F: '/^profile:/ {gsub(/[[:space:]]/, "", $2); print $2; exit}' "$profile_file" 2>/dev/null)
  case "$value" in
    self-host|upstream)
      SAGE_PROFILE="$value"
      SAGE_PROFILE_SOURCE="$profile_file"
      ;;
    "")
      SAGE_PROFILE_SOURCE="$profile_file (no profile: field — default upstream)"
      ;;
    *)
      SAGE_PROFILE_SOURCE="$profile_file (invalid value '$value' — default upstream)"
      ;;
  esac
}

resolve_framework
resolve_profile

canonical_dir() {
  local dir="$1"
  [ -d "$dir" ] || return 1
  (cd "$dir" && pwd -P)
}

is_framework_repo() {
  local dir="${1:-}"
  [ -f "$dir/core/registry.yaml" ] && [ -d "$dir/core/capabilities" ]
}

record_framework_source() {
  local target="$1"
  local source="$2"
  local marker="$target/sage/.sage-framework-source"
  local current=""
  local resolved_source=""

  [ -d "$target/sage" ] || return 0

  current=$(canonical_dir "$target/sage" 2>/dev/null || true)
  resolved_source=$(canonical_dir "$source" 2>/dev/null || true)
  [ -n "$resolved_source" ] || return 0

  if [ "$resolved_source" != "$current" ]; then
    printf "%s\n" "$resolved_source" > "$marker"
  else
    rm -f "$marker"
  fi
}

ensure_framework_entrypoint() {
  local target="$1"
  [ -f "$target/sage/bin/sage" ] || return 0
  chmod +x "$target/sage/bin/sage"
}

# ── codex_hooks_enabled ──
# Reads `[features].codex_hooks` from a project's .codex/config.toml.
# Returns 0 (true) iff the field is explicitly `true`. Default `false`
# preserves user surprise-avoidance: missing config → no hook wiring.
# Pure bash regex — no external TOML parser dependency. Recognized
# forms: `codex_hooks = true`, `codex_hooks=true`, `codex_hooks = "true"`.
codex_hooks_enabled() {
  local target="$1"
  local config="$target/.codex/config.toml"
  [ -f "$config" ] || return 1
  awk '
    /^\[features\]/ { in_features=1; next }
    /^\[/           { in_features=0; next }
    in_features && /^[[:space:]]*codex_hooks[[:space:]]*=/ {
      gsub(/[[:space:]]/, "", $0)
      sub(/^codex_hooks=/, "", $0)
      gsub(/"/, "", $0)
      print $0
      exit
    }
  ' "$config" | grep -qx "true"
}

# ── codex_hook_known_hash ──
# Returns 0 iff the given sha256 is listed in the framework's
# .versions.txt registry (current OR historical). 1 otherwise.
# Used by the shadow-file detection in ensure_codex_hooks_wired.
codex_hook_known_hash() {
  local hash="$1"
  local versions="$SAGE_FRAMEWORK/runtime/platforms/codex/hooks/.versions.txt"
  [ -f "$versions" ] || return 1
  awk -v h="$hash" '
    /^[[:space:]]*#/ { next }
    NF == 0          { next }
    $1 == h          { found=1; exit }
    END              { exit !found }
  ' "$versions"
}

# ── ensure_codex_hooks_wired ──
# L4 enforcement: if a project opts in via [features].codex_hooks=true,
# wire the framework's Codex hook scripts and merge canonical entries
# into .codex/hooks.json. Idempotent and shadow-safe per ADR-1:
#
#   1. Read [features].codex_hooks. Absent/false → no-op.
#   2. For each framework hook script, copy to .codex/hooks/<name>.sh
#      using the identity rule:
#        - target absent           → copy.
#        - target hash == current  → no-op.
#        - target hash ∈ versions  → known historical, safe replace.
#        - target hash unknown     → SHADOW. Refuse, surface MISCONFIGURED,
#                                    return non-zero. User must resolve
#                                    explicitly (--force-codex-hooks
#                                    flag deferred to a future cycle).
#   3. Atomic backup .codex/hooks.json → .codex/hooks.json.sage-bak.<ISO-ts>.
#   4. JSON merge:
#        - For each event in template, drop existing matcher-groups whose
#          inner hooks[*].command references any framework hook path
#          ($root/.codex/hooks/<known>.sh) — those are stale framework
#          entries we own.
#        - Preserve all other matcher-groups (user entries).
#        - Append framework entries for the event.
#      Atomic write via tmp + rename. Python3 used for json.load/dump
#      reliability (jq optional dependency would block fresh installs).
ensure_codex_hooks_wired() {
  local target="$1"
  local hooks_src_dir="$SAGE_FRAMEWORK/runtime/platforms/codex/hooks"
  local hooks_template="$hooks_src_dir/hooks.template.json"
  local hooks_dest_dir="$target/.codex/hooks"
  local hooks_json="$target/.codex/hooks.json"

  if ! codex_hooks_enabled "$target"; then
    return 0
  fi
  if [ ! -d "$hooks_src_dir" ] || [ ! -f "$hooks_template" ]; then
    step_warn "codex hooks: framework source missing ($hooks_src_dir) — skipping"
    return 0
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    step_fail "codex hooks: python3 required for hooks.json merge — skipping"
    return 1
  fi

  # ── Step 2: copy framework *.sh files with shadow-file detection ──
  mkdir -p "$hooks_dest_dir"
  local script src dest src_hash dst_hash any_misconfig=0
  for src in "$hooks_src_dir"/*.sh; do
    [ -f "$src" ] || continue
    script="$(basename "$src")"
    dest="$hooks_dest_dir/$script"
    src_hash=$(shasum -a 256 "$src" 2>/dev/null | cut -d" " -f1)
    if [ ! -f "$dest" ]; then
      cp "$src" "$dest" && chmod +x "$dest"
      continue
    fi
    dst_hash=$(shasum -a 256 "$dest" 2>/dev/null | cut -d" " -f1)
    if [ -z "$src_hash" ] || [ -z "$dst_hash" ]; then
      step_warn "codex hooks: cannot hash $script — leaving as-is"
      continue
    fi
    if [ "$src_hash" = "$dst_hash" ]; then
      continue                                 # already current
    fi
    if codex_hook_known_hash "$dst_hash"; then
      cp "$src" "$dest" && chmod +x "$dest"     # known historical → safe replace
      continue
    fi
    step_fail "codex hooks: SHADOW file at .codex/hooks/$script (unknown hash $dst_hash)"
    any_misconfig=1
  done
  if [ "$any_misconfig" -ne 0 ]; then
    echo "  ${RED}MISCONFIGURED${RESET} — refusing to overwrite shadow files." >&2
    echo "  ${DIM}Resolve manually, then re-run sage update. (--force-codex-hooks deferred.)${RESET}" >&2
    return 2
  fi

  # ── Step 3: atomic backup of hooks.json (only if it exists & non-empty) ──
  local backup=""
  if [ -s "$hooks_json" ]; then
    local ts
    ts=$(date -u +%Y%m%dT%H%M%SZ)
    backup="$hooks_json.sage-bak.$ts"
    cp "$hooks_json" "$backup"
  fi

  # ── Step 4: JSON merge via python3 (atomic tmp+rename) ──
  local merged_tmp
  merged_tmp=$(mktemp "$hooks_json.sage-merge.XXXXXX") || {
    step_fail "codex hooks: cannot create temp file"
    return 1
  }

  python3 - "$hooks_json" "$hooks_template" "$merged_tmp" <<'PYEOF'
import json, os, sys

current_path, template_path, out_path = sys.argv[1:4]

if os.path.exists(current_path) and os.path.getsize(current_path) > 0:
    with open(current_path) as f:
        try:
            current = json.load(f)
        except json.JSONDecodeError as e:
            sys.stderr.write(f"  hooks.json invalid JSON: {e}\n")
            sys.exit(2)
else:
    current = {}

with open(template_path) as f:
    tmpl = json.load(f)
tmpl.pop("_comment", None)

KNOWN = ("session-start.sh", "pre-prompt.sh", "pre-bash.sh", "post-bash.sh")

def is_framework_group(group):
    """A matcher-group is framework-owned iff any inner hook command
    references one of the known framework hook script paths."""
    for h in group.get("hooks", []) or []:
        cmd = h.get("command", "") or ""
        if ".codex/hooks/" in cmd and any(name in cmd for name in KNOWN):
            return True
    return False

current.setdefault("hooks", {})
for event, fw_groups in tmpl.get("hooks", {}).items():
    existing = current["hooks"].get(event, []) or []
    user_groups = [g for g in existing if not is_framework_group(g)]
    current["hooks"][event] = list(fw_groups) + user_groups

with open(out_path, "w") as f:
    json.dump(current, f, indent=2)
    f.write("\n")
PYEOF
  local rc=$?
  if [ "$rc" -ne 0 ]; then
    rm -f "$merged_tmp"
    step_fail "codex hooks: JSON merge failed"
    return "$rc"
  fi

  mv -f "$merged_tmp" "$hooks_json"
  if [ -n "$backup" ]; then
    step_ok_notimed "codex hooks: merged into .codex/hooks.json (backup: $(basename "$backup"))"
  else
    step_ok_notimed "codex hooks: wrote .codex/hooks.json"
  fi
  return 0
}

# ── detect_existing_hooks_framework ──
# Returns the most-specific match for what occupies a project's git
# hooks slot. Recognized frameworks (per ADR-3):
#
#   husky | lefthook | pre-commit | simple-git-hooks | custom-scripts | none
#
# Side-channel: prints (to stdout) a single line of the form
#   <framework>\t<custom_hooks_path>
# stripped of leading whitespace. Caller can `read framework path`.
#
# Detection runs even if `core.hooksPath` is unset — frameworks like
# Husky drop a `.husky/` dir without changing `core.hooksPath` (they
# wire `prepare` script). The custom_hooks_path falls back to
# `.git/hooks` when no override is configured.
detect_existing_hooks_framework() {
  local target="$1"
  local custom_path
  custom_path=$(git -C "$target" config --get core.hooksPath 2>/dev/null || true)
  [ -n "$custom_path" ] || custom_path=".git/hooks"

  local framework="none"
  if [ -d "$target/.husky" ] || [ -d "$target/node_modules/husky" ]; then
    framework="husky"
  elif [ -f "$target/lefthook.yml" ] || [ -f "$target/lefthook.yaml" ]; then
    framework="lefthook"
  elif [ -f "$target/.pre-commit-config.yaml" ] || [ -f "$target/.pre-commit-config.yml" ]; then
    framework="pre-commit"
  elif [ -f "$target/package.json" ] && grep -q '"simple-git-hooks"' "$target/package.json" 2>/dev/null; then
    framework="simple-git-hooks"
  else
    # Last-resort: are there any executable scripts in custom_path?
    local hp="$target/$custom_path"
    if [ -d "$hp" ]; then
      local f any=0
      for f in "$hp"/*; do
        [ -f "$f" ] && [ -x "$f" ] && [ "$(basename "$f")" != "pre-commit" ] && { any=1; break; }
        [ -f "$f" ] && [ -x "$f" ] && [ "$(basename "$f")" = "pre-commit" ] && {
          # pre-commit alone is fine; check if it's the framework script we'd be
          # replacing — only count as custom-scripts if other hooks coexist.
          any=1; break;
        }
      done
      [ "$any" -eq 1 ] && framework="custom-scripts"
    fi
  fi

  printf "%s\t%s\n" "$framework" "$custom_path"
}

# ── force_githooks_override ──
# Implements the `--force-githooks` opt-in flow per ADR-3 Component 2.
#
# Preconditions (caller validates target is a git repo):
#   - target must be a git repo.
#   - .githooks/pre-commit must exist (else nothing to point at).
#
# Flow:
#   1. Read current core.hooksPath. If empty or already `.githooks`,
#      delegate to ensure_hooks_wired (regular auto-wire path).
#   2. Else: detect existing framework, `ls -la <custom_path>`, prompt
#      "This will deactivate <framework>. Continue? [y/N]".
#   3. On yes: git config --unset + set .githooks + copy hook + log.
#   4. On no: exit 1, no changes.
force_githooks_override() {
  local target="$1"
  local hook_dest="$target/.githooks/pre-commit"
  local hook_src=""

  if [ -n "${SAGE_FRAMEWORK:-}" ] && [ -f "$SAGE_FRAMEWORK/.githooks/pre-commit" ]; then
    hook_src="$SAGE_FRAMEWORK/.githooks/pre-commit"
  elif [ -f "$target/sage/.githooks/pre-commit" ]; then
    hook_src="$target/sage/.githooks/pre-commit"
  fi

  if [ ! -d "$target/.git" ] && [ ! -f "$target/.git" ]; then
    step_warn "force-githooks: not a git repo — skipping"
    return 0
  fi

  local current
  current=$(git -C "$target" config --get core.hooksPath 2>/dev/null || true)
  if [ -z "$current" ] || [ "$current" = ".githooks" ]; then
    # No custom path to override — fall through to regular wiring.
    ensure_hooks_wired "$target"
    return 0
  fi

  # Detect what's there.
  local detect framework custom_path
  detect=$(detect_existing_hooks_framework "$target")
  framework=$(printf "%s" "$detect" | cut -f1)
  custom_path=$(printf "%s" "$detect" | cut -f2)

  echo ""
  echo -e "  ${YELLOW}--force-githooks: about to override existing setup${RESET}"
  echo ""
  echo "  Custom hooks path:  $custom_path"
  echo "  Detected framework: $framework"
  echo ""
  echo "  Files in path:"
  if [ -d "$target/$custom_path" ]; then
    ls -la "$target/$custom_path" 2>/dev/null \
      | tail -n +2 \
      | awk 'NR>1 || /^total/ { next } 1' \
      | awk '{ printf "    "; for (i=9; i<=NF; i++) printf "%s ", $i; print "" }' \
      | head -20 || true
    # Fallback when above filter eats too much: simple ls -1
    if [ -z "$(ls -A "$target/$custom_path" 2>/dev/null)" ]; then
      echo "    (empty)"
    fi
  else
    echo "    (path does not exist)"
  fi
  echo ""

  local label="$framework"
  [ "$framework" = "none" ] && label="these custom scripts"
  [ "$framework" = "custom-scripts" ] && label="these custom scripts"

  printf "  This will deactivate %s. Continue? [y/N]: " "$label"
  local confirm=""
  read -r confirm
  case "$confirm" in
    y|Y|yes|YES) ;;
    *) echo "  Aborted. No changes." ; return 1 ;;
  esac

  # Apply override.
  git -C "$target" config --unset core.hooksPath || true
  git -C "$target" config core.hooksPath .githooks
  mkdir -p "$target/.githooks"
  if [ -n "$hook_src" ] && [ "$hook_src" != "$hook_dest" ]; then
    cp "$hook_src" "$hook_dest"
    chmod +x "$hook_dest"
  fi
  step_ok_notimed "force-githooks: core.hooksPath set to .githooks (was: $current)"
  step_ok_notimed "force-githooks: .githooks/pre-commit installed"
  echo "    ${DIM}Previous hooks at $custom_path were left in place but no longer fire.${RESET}"
  return 0
}

# ── ensure_hooks_wired ──
# Sage L5 pre-commit gate must be activated per-clone (git config
# core.hooksPath does not travel with the repo). This function:
#   1. Copies .githooks/pre-commit from the framework into the target
#      project ONLY when the target has no hook yet OR the existing
#      hook is byte-identical to the framework version.
#      When a different hook is found we PRESERVE it (could be user
#      edits OR a stale-shipped version — we cannot tell apart safely
#      without a manifest of known-good hashes), and write the new
#      framework version next to it as `.sage-new` so the user can
#      diff and merge by hand.
#   2. Sets git config core.hooksPath = .githooks ONLY when the value
#      is currently unset OR already .githooks (idempotent, never
#      clobbers a custom user value).
#   3. Skips silently when target is not a git repo.
# Self-host case (framework_repo=true): the hook source already lives
# at $target/.githooks/pre-commit; the copy step is a no-op and only
# the git config wire runs.
# Worktree note: `git config core.hooksPath` is per-worktree by default
# in modern git, so users with multiple worktrees of the same repo
# need to wire each one (or set it in the main repo with
# `git config --global core.hooksPath .githooks`).
ensure_hooks_wired() {
  local target="$1"
  local hook_dest="$target/.githooks/pre-commit"
  local hook_src=""

  # Resolve hook source. SAGE_FRAMEWORK points at the framework root;
  # when running self-host, $target == $SAGE_FRAMEWORK and the source
  # already IS the destination.
  if [ -n "${SAGE_FRAMEWORK:-}" ] && [ -f "$SAGE_FRAMEWORK/.githooks/pre-commit" ]; then
    hook_src="$SAGE_FRAMEWORK/.githooks/pre-commit"
  elif [ -f "$target/sage/.githooks/pre-commit" ]; then
    hook_src="$target/sage/.githooks/pre-commit"
  fi

  # ── Step 1: copy (skip if no source, same file, or user-modified) ──
  if [ -n "$hook_src" ] && [ "$hook_src" != "$hook_dest" ]; then
    mkdir -p "$target/.githooks"
    if [ ! -f "$hook_dest" ]; then
      cp "$hook_src" "$hook_dest"
      chmod +x "$hook_dest"
      step_ok_notimed "hooks: pre-commit copied to .githooks/"
    else
      local src_hash dst_hash
      src_hash=$(shasum -a 256 "$hook_src" 2>/dev/null | cut -d" " -f1)
      dst_hash=$(shasum -a 256 "$hook_dest" 2>/dev/null | cut -d" " -f1)
      if [ "$src_hash" = "$dst_hash" ]; then
        : # same content — no-op (also covers framework auto-upgrade
          # case: when src changes and dst was unmodified, dst_hash
          # would NOT match the new src — fall through to else branch).
      elif [ -z "$dst_hash" ] || [ -z "$src_hash" ]; then
        : # cannot compute either side, leave dest alone
      else
        # Determine whether dst is an unmodified older framework version
        # by checking against the shipped src — if hashes differ AND
        # dst differs from src, it could be (a) user-edited or (b)
        # older shipped version. We cannot tell apart safely, so we
        # default to PRESERVE and warn.
        cp "$hook_src" "$hook_dest.sage-new"
        step_warn "hooks: .githooks/pre-commit differs from framework version (kept your copy; new version at .githooks/pre-commit.sage-new)"
      fi
    fi
  fi

  # ── Step 2: wire core.hooksPath if safe ──
  if [ ! -d "$target/.git" ] && [ ! -f "$target/.git" ]; then
    return 0  # not a git repo, nothing to wire
  fi
  if [ ! -f "$hook_dest" ]; then
    return 0  # no hook in target, nothing to wire
  fi

  local current
  current=$(git -C "$target" config --get core.hooksPath 2>/dev/null || true)
  if [ -z "$current" ]; then
    git -C "$target" config core.hooksPath .githooks
    step_ok_notimed "hooks: core.hooksPath = .githooks (auto-wired)"
  elif [ "$current" = ".githooks" ]; then
    : # already wired correctly
  else
    step_info "hooks: core.hooksPath = $current (custom — left as-is)"
  fi
}

# ── COMMAND: install-hooks ──
# Standalone entry point. Calls ensure_hooks_wired against the cwd.
# bin/sage-install-hooks delegates here so the two cannot drift.
sage_install_hooks() {
  local target
  target="$(pwd)"
  if [ ! -d "$target/.git" ] && [ ! -f "$target/.git" ]; then
    echo ""
    echo -e "  ${RED}❌ Not inside a git repository.${RESET}"
    exit 1
  fi
  if [ -z "${SAGE_FRAMEWORK:-}" ]; then
    resolve_framework
  fi
  if [ -z "${SAGE_FRAMEWORK:-}" ] || [ ! -f "$SAGE_FRAMEWORK/.githooks/pre-commit" ]; then
    echo ""
    echo -e "  ${RED}❌ Framework hook source not found.${RESET}"
    echo -e "  ${DIM}Looked at: ${SAGE_FRAMEWORK:-<unset>}/.githooks/pre-commit${RESET}"
    echo -e "  ${DIM}Run 'sage update' first, or pass SAGE_FRAMEWORK=<path>.${RESET}"
    exit 1
  fi
  echo ""
  echo -e "  ${BOLD}Sage — Install Hooks${RESET}"
  ensure_hooks_wired "$target"
  echo ""
}

resolve_update_source() {
  local target="$1"
  local current="$target/sage"
  local current_resolved=""
  local candidate=""
  local marker="$current/.sage-framework-source"

  current_resolved=$(canonical_dir "$current" 2>/dev/null || true)

  candidate=$(canonical_dir "${SAGE_FRAMEWORK:-}" 2>/dev/null || true)
  if [ -n "$candidate" ] && [ "$candidate" != "$current_resolved" ]; then
    printf "%s\n" "$candidate"
    return 0
  fi

  if [ -f "$marker" ]; then
    candidate=$(head -n 1 "$marker" 2>/dev/null || true)
    candidate=$(canonical_dir "$candidate" 2>/dev/null || true)
    if [ -n "$candidate" ] && [ "$candidate" != "$current_resolved" ]; then
      printf "%s\n" "$candidate"
      return 0
    fi
  fi

  if [ -n "${SAGE_HOME:-}" ] && [ -d "$SAGE_HOME/framework/core" ]; then
    candidate=$(canonical_dir "$SAGE_HOME/framework" 2>/dev/null || true)
    if [ -n "$candidate" ] && [ "$candidate" != "$current_resolved" ]; then
      printf "%s\n" "$candidate"
      return 0
    fi
  fi

  if [ -d "$HOME/.sage/framework/core" ]; then
    candidate=$(canonical_dir "$HOME/.sage/framework" 2>/dev/null || true)
    if [ -n "$candidate" ] && [ "$candidate" != "$current_resolved" ]; then
      printf "%s\n" "$candidate"
      return 0
    fi
  fi

  return 1
}

# ═══════════════════════════════════════════════════════════════
# SHARED FUNCTIONS
# ═══════════════════════════════════════════════════════════════

prune_framework_copy() {
  local sage_dir="$1"
  rm -rf "$sage_dir/.git" "$sage_dir/.github" "$sage_dir/.tmp"
  rm -f "$sage_dir/.DS_Store"
}

ask_choice() {
  local prompt="$1"
  shift
  local options=("$@")
  local count=${#options[@]}

  echo "" >&2
  echo -e "  ${BOLD}$prompt${RESET}" >&2
  echo "" >&2
  for i in "${!options[@]}"; do
    echo "    $((i + 1))) ${options[$i]}" >&2
  done
  echo "" >&2
  printf "  Choice [1-$count]: " >&2
  read -r choice

  if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt "$count" ]; then
    choice=1
  fi
  echo "$choice"
}

platform_has() {
  local needle="$1"
  case ",${PLATFORM:-}," in
    *,"$needle",*) return 0 ;;
    *) return 1 ;;
  esac
}

platform_append() {
  local platform_name="$1"
  if [ -z "${PLATFORM:-}" ]; then
    PLATFORM="$platform_name"
    return
  fi
  platform_has "$platform_name" || PLATFORM="${PLATFORM},${platform_name}"
}

platform_label() {
  local value="${1:-${PLATFORM:-}}"
  if [ -z "$value" ]; then
    echo "none"
    return
  fi
  echo "$value" | sed 's/,/, /g'
}

normalize_platform_value() {
  local raw="${1:-}"
  local compact="${raw//[[:space:]]/}"
  local expanded=""
  local normalized=()
  local token
  local valid

  [ -n "$compact" ] || return 1

  IFS=',' read -r -a requested <<< "$compact"
  for token in "${requested[@]}"; do
    case "$token" in
      both)
        if [ -n "$expanded" ]; then
          expanded="$expanded,claude-code,antigravity"
        else
          expanded="claude-code,antigravity"
        fi
        ;;
      claude-code|antigravity|codex)
        if [ -n "$expanded" ]; then
          expanded="$expanded,$token"
        else
          expanded="$token"
        fi
        ;;
      *)
        return 1
        ;;
    esac
  done

  IFS=',' read -r -a requested <<< "$expanded"
  for valid in claude-code antigravity codex; do
    for token in "${requested[@]}"; do
      if [ "$token" = "$valid" ]; then
        normalized+=("$valid")
        break
      fi
    done
  done

  [ "${#normalized[@]}" -gt 0 ] || return 1

  local joined=""
  for token in "${normalized[@]}"; do
    if [ -n "$joined" ]; then
      joined="$joined,$token"
    else
      joined="$token"
    fi
  done

  echo "$joined"
}

select_platform() {
  local target="$1"
  PLATFORM=""

  if [ -n "${PLATFORM_FLAG:-}" ]; then
    if ! PLATFORM="$(normalize_platform_value "$PLATFORM_FLAG")"; then
      echo ""
      echo -e "  ${RED}❌ Invalid --platform value: ${PLATFORM_FLAG}${RESET}"
      echo "  Valid values: claude-code, antigravity, codex"
      echo "  You can combine them with commas, e.g. claude-code,codex"
      echo "  Legacy alias supported: both -> claude-code,antigravity"
      exit 1
    fi
    echo -e "  ${GREEN}Platform:${RESET} $(platform_label)"
    return
  fi

  # Auto-detect from existing files
  local has_agent=false has_claude=false has_codex=false
  [ -d "$target/.agent" ] && has_agent=true
  [ -f "$target/GEMINI.md" ] && has_agent=true
  [ -d "$target/.claude" ] && has_claude=true
  # Check if CLAUDE.md is Sage-generated
  if [ -f "$target/CLAUDE.md" ] && head -1 "$target/CLAUDE.md" | grep -q "Sage"; then
    has_claude=true
  fi
  if [ -d "$target/.agents/skills/sage-navigator" ] || [ -f "$target/.codex/config.toml" ]; then
    has_codex=true
  fi
  if [ -f "$target/AGENTS.md" ] && head -1 "$target/AGENTS.md" | grep -q "Sage"; then
    has_codex=true
  fi

  [ "$has_claude" = true ] && platform_append "claude-code"
  [ "$has_agent" = true ] && platform_append "antigravity"
  [ "$has_codex" = true ] && platform_append "codex"

  if [ -n "$PLATFORM" ]; then
    echo -e "  ${GREEN}Detected:${RESET} $(platform_label)"
    return
  fi

  # Ask interactively
  if [ -t 0 ]; then
    local choice
    choice=$(ask_choice \
      "Which platform are you using?" \
      "Claude Code" \
      "Antigravity" \
      "Codex" \
      "Claude Code + Antigravity" \
      "Claude Code + Codex" \
      "Antigravity + Codex" \
      "All three")
    case "$choice" in
      2) PLATFORM="antigravity" ;;
      3) PLATFORM="codex" ;;
      4) PLATFORM="claude-code,antigravity" ;;
      5) PLATFORM="claude-code,codex" ;;
      6) PLATFORM="antigravity,codex" ;;
      7) PLATFORM="claude-code,antigravity,codex" ;;
      *) PLATFORM="claude-code" ;;
    esac
  else
    PLATFORM="claude-code"
  fi
}

detect_stack() {
  local target="$1"
  DETECTED_STACK=""

  if [ -f "$target/package.json" ]; then
    local pkg="$target/package.json"
    grep -q '"next"' "$pkg" 2>/dev/null && DETECTED_STACK="$DETECTED_STACK next"
    grep -q '"react"' "$pkg" 2>/dev/null && DETECTED_STACK="$DETECTED_STACK react"
    grep -q '"vue"' "$pkg" 2>/dev/null && DETECTED_STACK="$DETECTED_STACK vue"
    grep -q '"svelte"' "$pkg" 2>/dev/null && DETECTED_STACK="$DETECTED_STACK svelte"
    grep -q '"react-native"' "$pkg" 2>/dev/null && DETECTED_STACK="$DETECTED_STACK react-native"
    grep -q '"@supabase"' "$pkg" 2>/dev/null && DETECTED_STACK="$DETECTED_STACK supabase"
    grep -q '"firebase"' "$pkg" 2>/dev/null && DETECTED_STACK="$DETECTED_STACK firebase"
    grep -q '"express"\|"fastify"\|"hono"' "$pkg" 2>/dev/null && DETECTED_STACK="$DETECTED_STACK node-api"
  fi
  [ -f "$target/pubspec.yaml" ] && DETECTED_STACK="$DETECTED_STACK flutter"
  [ -f "$target/requirements.txt" ] || [ -f "$target/pyproject.toml" ] && DETECTED_STACK="$DETECTED_STACK python"
  [ -f "$target/go.mod" ] && DETECTED_STACK="$DETECTED_STACK go"
  [ -f "$target/Cargo.toml" ] && DETECTED_STACK="$DETECTED_STACK rust"

  DETECTED_STACK=$(echo "$DETECTED_STACK" | xargs)

  if [ -z "$DETECTED_STACK" ]; then
    echo -e "  ${DIM}No stack detected${RESET}"
  else
    echo -e "  ${GREEN}Stack:${RESET} $DETECTED_STACK"
  fi
}

copy_framework() {
  local target="$1"
  if [ -d "$target/sage" ]; then
    ensure_framework_entrypoint "$target"
    echo -e "  ${GREEN}✓${RESET} sage/ already present"
  else
    cp -a "$SAGE_FRAMEWORK" "$target/sage" &
    spin $! "Copying framework..."
    prune_framework_copy "$target/sage"
    record_framework_source "$target" "$SAGE_FRAMEWORK"
    ensure_framework_entrypoint "$target"
    echo -e "  ${GREEN}✓${RESET} sage/ copied to project"
  fi
}

select_preset() {
  local target="$1"
  SELECTED_PRESET=""

  # Check for --preset flag (set by CLI parser)
  if [ -n "${PRESET_FLAG:-}" ]; then
    case "$PRESET_FLAG" in
      base|startup|enterprise|opensource|none)
        SELECTED_PRESET="$PRESET_FLAG"
        echo -e "  ${GREEN}Preset:${RESET} $SELECTED_PRESET"
        return
        ;;
      *)
        echo -e "  ${YELLOW}Unknown preset: $PRESET_FLAG. Using base.${RESET}"
        SELECTED_PRESET="base"
        return
        ;;
    esac
  fi

  # Check if constitution already exists (re-init)
  if [ -f "$target/.sage/constitution.md" ]; then
    local existing
    existing=$(sed -n '/^extends:/s/^extends: *//p' "$target/.sage/constitution.md" 2>/dev/null)
    if [ -n "$existing" ]; then
      SELECTED_PRESET="$existing"
      echo -e "  ${GREEN}Preset:${RESET} $existing (from existing constitution)"
      return
    fi
  fi

  # Ask interactively
  if [ -t 0 ]; then
    local choice
    choice=$(ask_choice "Select a constitution preset:" \
      "base — universal engineering principles (default)" \
      "startup — ship fast, monolith first, one way to do things" \
      "enterprise — auth everywhere, audit trails, postmortems" \
      "opensource — docs mirror code, semver contract, contributor-friendly" \
      "none — base only, no preset")
    case "$choice" in
      2) SELECTED_PRESET="startup" ;;
      3) SELECTED_PRESET="enterprise" ;;
      4) SELECTED_PRESET="opensource" ;;
      5) SELECTED_PRESET="base" ;;
      *) SELECTED_PRESET="base" ;;
    esac
  else
    SELECTED_PRESET="base"
  fi
  echo -e "  ${GREEN}Preset:${RESET} $SELECTED_PRESET"
}

apply_prefix_config() {
  local config="$1/.sage/config.yaml"
  [ -f "$config" ] || return 0
  local prefix_val="false"
  [ "$PREFIX_FLAG" = "true" ] && prefix_val="true"
  if grep -q 'command_prefix:' "$config" 2>/dev/null; then
    sed -i.bak "s/^command_prefix:.*$/command_prefix: $prefix_val/" "$config" && rm -f "${config}.bak"
  else
    echo "command_prefix: $prefix_val" >> "$config"
  fi
}

create_sage_state() {
  local target="$1"
  local project_name
  project_name=$(basename "$target")
  local sage_dir="$target/.sage"
  local prefix_val="false"
  local created_state=false
  local preserved_state=false

  [ "$PREFIX_FLAG" = "true" ] && prefix_val="true"
  mkdir -p "$sage_dir/work" "$sage_dir/docs" "$sage_dir/gates/scripts"

  if [ -d "$target/.sage" ]; then
    preserved_state=true
  fi

  if [ ! -f "$sage_dir/config.yaml" ]; then
    cat > "$sage_dir/config.yaml" << YAML
sage-version: "1.0.0"
project-name: "$project_name"
platform: "${PLATFORM:-claude-code}"
constitution: "${SELECTED_PRESET:-base}"
detected-stack: [$DETECTED_STACK]
auto_review: true
auto_qa: true
independent_gate3: true
command_prefix: $prefix_val
YAML
    created_state=true
  else
    apply_prefix_config "$target"
  fi

  if [ ! -f "$sage_dir/decisions.md" ]; then
    cat > "$sage_dir/decisions.md" << MD
# Decisions

Shared log for significant decisions and context.
Both the AI agent and human collaborators write here.

- [$(date +%Y-%m-%d)] Sage initialized for $project_name
MD
    created_state=true
  fi

  if [ ! -f "$sage_dir/conventions.md" ]; then
    cat > "$sage_dir/conventions.md" << MD
# Project Conventions

Discovered by Sage on $(date +%Y-%m-%d).
The codebase-scan capability will enrich this on first run.
MD
    created_state=true
  fi

  # Gate scripts
  for script in "$SAGE_FRAMEWORK/core/gates/scripts/"*.sh; do
    [ -f "$script" ] || continue
    cp "$script" "$sage_dir/gates/scripts/"
    chmod +x "$sage_dir/gates/scripts/$(basename "$script")"
  done

  # Gate activation config
  local gate_config="$SAGE_FRAMEWORK/core/gates/_config/gate-modes.yaml"
  if [ -f "$gate_config" ]; then
    cp "$gate_config" "$sage_dir/gates/gate-modes.yaml"
  fi

  # Constitution
  if [ ! -f "$sage_dir/constitution.md" ] && [ -n "${SELECTED_PRESET:-}" ] && [ "$SELECTED_PRESET" != "base" ] && [ "$SELECTED_PRESET" != "none" ]; then
    cat > "$sage_dir/constitution.md" << CONSTMD
---
name: "$project_name"
extends: $SELECTED_PRESET
---

## Project Additions

(Add project-specific principles here)
CONSTMD
    created_state=true
  fi

  if [ "$preserved_state" = true ] && [ "$created_state" = true ]; then
    echo -e "  ${GREEN}✓${RESET} .sage/ preserved and bootstrapped (existing state)"
  elif [ "$preserved_state" = true ]; then
    echo -e "  ${GREEN}✓${RESET} .sage/ preserved (existing state)"
  else
    echo -e "  ${GREEN}✓${RESET} .sage/ initialized"
  fi
}

run_generators() {
  local target="$1"
  local sage_path="$target/sage"
  [ -d "$sage_path" ] || sage_path="$SAGE_FRAMEWORK"
  export SAGE_FRAMEWORK_DIR="$sage_path"
  export SAGE_PROFILE="${SAGE_PROFILE:-upstream}"

  if platform_has "antigravity"; then
    echo ""
    bash "$sage_path/runtime/platforms/antigravity/setup/generate-antigravity.sh" "$target"
  fi

  if platform_has "claude-code"; then
    echo ""
    bash "$sage_path/runtime/platforms/claude-code/setup/generate-claude-code.sh" "$target"
  fi

  if platform_has "codex"; then
    echo ""
    bash "$sage_path/runtime/platforms/codex/setup/generate-codex.sh" "$target"
  fi

  unset SAGE_FRAMEWORK_DIR
}

print_success() {
  local target="$1"
  local project_name
  project_name=$(basename "$target")

  # Constitution info
  local preset_info="base"
  [ -n "${SELECTED_PRESET:-}" ] && [ "$SELECTED_PRESET" != "base" ] && preset_info="$SELECTED_PRESET"

  sage_complete

  # Command prefix display
  local p=""
  [ "$PREFIX_FLAG" = "true" ] && p="sage:"

  echo -e "  ${BOLD}Get started:${RESET}"
  echo ""
  if platform_has "claude-code"; then
    echo "    1. Open this project in your IDE"
    echo -e "    2. Type ${BOLD}/sage${RESET} and describe what you want to build"
    echo ""
    echo -e "  ${DIM}Commands: /${p}build  /${p}fix  /${p}architect  /${p}status  /${p}review  /${p}learn${RESET}"
  fi
  if platform_has "antigravity"; then
    echo "    1. Open this project in Antigravity"
    echo -e "    2. Type ${BOLD}/sage${RESET} and describe what you want to build"
    echo ""
    echo -e "  ${DIM}Commands: /${p}build  /${p}fix  /${p}architect  /${p}status  /${p}review  /${p}learn${RESET}"
  fi
  if platform_has "codex"; then
    echo "    1. Open this project in Codex"
    echo "    2. Use AGENTS.md and the Sage skills in .agents/skills/"
    echo ""
    echo -e "  ${DIM}Codex surfaces: AGENTS.md  .agents/skills/  .codex/config.toml${RESET}"
    echo -e "  ${DIM}Built-in helper: /review for diff-oriented review passes${RESET}"
  fi

  if [ "${SELF_HOST_FLAG:-}" = "true" ] && is_framework_repo "$target"; then
    echo ""
    echo -e "  ${DIM}Self-host mode: using the local framework checkout in place — no nested sage/ copied${RESET}"
  fi

  # Check for sage-memory
  local has_memory=false
  if [ -f "$HOME/.claude.json" ] && grep -q "sage-memory" "$HOME/.claude.json" 2>/dev/null; then
    has_memory=true
  fi
  if [ -f "$target/.claude.json" ] && grep -q "sage-memory" "$target/.claude.json" 2>/dev/null; then
    has_memory=true
  fi
  if [ -f "$target/.codex/config.toml" ] && grep -q "sage-memory" "$target/.codex/config.toml" 2>/dev/null; then
    has_memory=true
  fi

  if [ "$has_memory" = false ]; then
    echo ""
    echo -e "  ${DIM}Enable persistent memory:  sage setup memory${RESET}"
  fi

  echo ""
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: new <name>
# ═══════════════════════════════════════════════════════════════
sage_new() {
  local name="${1:-}"

  echo ""
  echo -e "  ${BOLD}Sage — New Project${RESET}"
  echo ""

  if [ -z "$name" ]; then
    printf "  Project name: " >&2
    read -r name
    if [ -z "$name" ]; then
      echo -e "  ${RED}❌ Project name is required.${RESET}"
      exit 1
    fi
  fi

  if [[ "$name" =~ [\ /\\] ]]; then
    echo -e "  ${RED}❌ Project name cannot contain spaces or slashes.${RESET}"
    exit 1
  fi

  if [ -d "$name" ]; then
    echo -e "  ${RED}❌ Directory '$name' already exists.${RESET}"
    echo "  Use 'sage init' inside it instead."
    exit 1
  fi

  echo -e "  Creating ${CYAN}$name${RESET}..."
  timer_start
  step_start

  mkdir -p "$name"
  local target
  target="$(cd "$name" && pwd)"

  copy_framework "$target"

  # Git init
  if [ ! -d "$target/.git" ]; then
    (cd "$target" && git init -q 2>/dev/null) || true
    echo -e "  ${GREEN}✓${RESET} Git initialized"
  fi

  detect_stack "$target"
  select_platform "$target"
  select_preset "$target"
  create_sage_state "$target"
  run_generators "$target"
  if [ "${FORCE_GITHOOKS_FLAG:-}" = "true" ]; then
    force_githooks_override "$target" || true
  else
    ensure_hooks_wired "$target"
  fi
  ensure_codex_hooks_wired "$target" || true
  print_success "$target"
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: init
# ═══════════════════════════════════════════════════════════════
sage_init() {
  local target
  local framework_repo=false
  target="$(pwd)"

  if is_framework_repo "$target"; then
    framework_repo=true
  fi

  # Safety: don't init inside the framework itself unless self-host mode is explicit
  if [ "$framework_repo" = true ] && [ "${SELF_HOST_FLAG:-}" != "true" ]; then
    echo ""
    echo -e "  ${RED}❌ You're inside the Sage framework directory.${RESET}"
    echo ""
    echo "  Run from your project directory instead:"
    echo "    cd /path/to/your/project"
    echo "    sage init"
    echo ""
    echo "  Private capability on this branch:"
    echo "    sage init --self-host --platform claude-code,codex"
    exit 1
  fi

  echo ""
  echo -e "  ${BOLD}Sage — Initialize Project${RESET}"
  echo ""
  echo -e "  Project: ${CYAN}$(basename "$target")${RESET}"
  echo -e "  Path:    ${DIM}$target${RESET}"
  timer_start
  step_start

  # Check if already initialized
  if [ -d "$target/.sage" ] && { [ -d "$target/sage" ] || [ "$framework_repo" = true ]; }; then
    echo -e "  ${YELLOW}Sage is already initialized in this project.${RESET}"
    echo ""
    echo "  To regenerate platform files: sage update"
    if [ "$framework_repo" = true ]; then
      echo "  To start over: remove .sage/ and generated platform files first"
    else
      echo "  To start over: remove .sage/ and sage/ first"
    fi
    echo ""
    printf "  Reinstall anyway? [y/N]: "
    read -r confirm
    if [ "$confirm" != "y" ] && [ "$confirm" != "Y" ]; then
      echo "  Cancelled."
      exit 0
    fi
    echo ""
  fi

  if [ "$framework_repo" = true ]; then
    echo -e "  ${GREEN}✓${RESET} Self-host mode enabled (reusing local framework checkout)"
  else
    copy_framework "$target"
  fi
  detect_stack "$target"
  select_platform "$target"
  select_preset "$target"
  create_sage_state "$target"
  run_generators "$target"
  if [ "${FORCE_GITHOOKS_FLAG:-}" = "true" ]; then
    force_githooks_override "$target" || true
  else
    ensure_hooks_wired "$target"
  fi
  ensure_codex_hooks_wired "$target" || true
  print_success "$target"
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: update
# ═══════════════════════════════════════════════════════════════
sage_update() {
  local target
  local update_source=""
  target="$(pwd)"

  if [ ! -d "$target/.sage" ]; then
    echo ""
    echo -e "  ${RED}❌ No Sage project found here.${RESET}"
    echo "  Run this from a directory with .sage/"
    echo "  Or run 'sage init' to set up Sage first."
    exit 1
  fi

  echo ""
  echo -e "  ${BOLD}Sage — Update Project${RESET}"
  echo ""
  echo -e "  Project: ${CYAN}$(basename "$target")${RESET}"
  timer_start
  step_start

  # Detect platform
  PLATFORM=""
  if [ -f "$target/GEMINI.md" ] || [ -d "$target/.agent" ]; then
    platform_append "antigravity"
  fi
  if [ -f "$target/CLAUDE.md" ] && head -1 "$target/CLAUDE.md" 2>/dev/null | grep -q "Sage"; then
    platform_append "claude-code"
  fi
  if [ -d "$target/.claude/commands" ]; then
    platform_append "claude-code"
  fi
  if [ -f "$target/AGENTS.md" ] && head -1 "$target/AGENTS.md" 2>/dev/null | grep -q "Sage"; then
    platform_append "codex"
  fi
  if [ -d "$target/.agents/skills/sage-navigator" ] || [ -f "$target/.codex/config.toml" ]; then
    platform_append "codex"
  fi

  if [ -z "$PLATFORM" ]; then
    echo -e "  ${YELLOW}No platform files found.${RESET}"
    echo "  Selecting platform..."
    select_platform "$target"
  else
    echo -e "  ${GREEN}Platform:${RESET} $(platform_label)"
  fi

  # Detect community skills before updating
  local community_skills=""
  if [ -f "$target/sage/skills/skills.json" ]; then
    community_skills=$(python3 -c "
import json, sys
try:
  d = json.load(open('$target/sage/skills/skills.json'))
  cs = [k for k, v in d.get('skills', {}).items() if v.get('source') != 'built-in']
  print(' '.join(cs))
except: pass
" 2>/dev/null)
  fi

  # Show what will happen
  echo ""
  echo "  This will:"
  if [ -d "$target/sage" ]; then
    echo -e "    ${CYAN}↻${RESET} Update sage/ framework to latest version"
  fi
  if platform_has "antigravity"; then
    echo -e "    ${CYAN}↻${RESET} Regenerate GEMINI.md and .agent/"
  fi
  if platform_has "claude-code"; then
    echo -e "    ${CYAN}↻${RESET} Regenerate CLAUDE.md and .claude/commands/"
  fi
  if platform_has "codex"; then
    echo -e "    ${CYAN}↻${RESET} Regenerate AGENTS.md, .agents/skills/, and .codex/config.toml"
  fi
  echo -e "    ${GREEN}✓${RESET} Preserve .sage/ project state (untouched)"
  if [ -n "$community_skills" ]; then
    echo -e "    ${GREEN}✓${RESET} Preserve community skills: $community_skills"
  fi

  echo ""
  if [ -t 0 ]; then
    printf "  [A] Proceed  |  [C] Cancel: "
    read -r confirm
    if [ "$confirm" != "A" ] && [ "$confirm" != "a" ] && [ "$confirm" != "" ]; then
      echo "  Cancelled."
      echo ""
      return
    fi
  fi

  echo ""

  # Backup community skills
  local backup_dir=""
  if [ -n "$community_skills" ]; then
    backup_dir=$(mktemp -d)
    for skill_name in $community_skills; do
      if [ -d "$target/sage/skills/$skill_name" ]; then
        cp -a "$target/sage/skills/$skill_name" "$backup_dir/"
      fi
    done
  fi

  # Update sage/ framework
  if [ -d "$target/sage" ]; then
    if ! update_source=$(resolve_update_source "$target"); then
      echo -e "  ${RED}✗${RESET} Cannot find a stable Sage framework source for update"
      echo ""
      echo "  Try one of:"
      echo "    1. Run update from an original Sage checkout"
      echo "    2. Install Sage globally so ~/.sage/framework is available"
      echo ""
      exit 1
    fi
    rm -rf "$target/sage"
    cp -a "$update_source" "$target/sage" &
    spin $! "Updating framework..."
    prune_framework_copy "$target/sage"
    record_framework_source "$target" "$update_source"
    ensure_framework_entrypoint "$target"
    echo -e "  ${GREEN}✓${RESET} sage/ updated"
  fi

  # Restore community skills
  if [ -n "$community_skills" ] && [ -n "$backup_dir" ]; then
    for skill_name in $community_skills; do
      if [ -d "$backup_dir/$skill_name" ]; then
        cp -a "$backup_dir/$skill_name" "$target/sage/skills/"
      fi
    done
    rm -rf "$backup_dir"

    # Re-register community skills in skills.json
    python3 -c "
import json, sys
try:
  with open('$target/sage/skills/skills.json') as f:
    d = json.load(f)
  for s in '$community_skills'.split():
    if s not in d.get('skills', {}):
      d.setdefault('skills', {})[s] = {'source': 'community', 'added': '$(date +%Y-%m-%d)'}
  with open('$target/sage/skills/skills.json', 'w') as f:
    json.dump(d, f, indent=2)
except: pass
" 2>/dev/null

    echo -e "  ${GREEN}✓${RESET} Community skills preserved: $community_skills"
  fi

  # Apply --prefix flag if provided
  [ "$PREFIX_FLAG" = "true" ] && apply_prefix_config "$target"

  # Regenerate platform files
  DETECTED_STACK=""
  detect_stack "$target"
  export SAGE_UPDATE_MODE=true
  run_generators "$target"
  unset SAGE_UPDATE_MODE

  # ── Migration: clean stale patterns from previous versions ──
  local migrated=0
  local migration_notes=""

  # Remove tasks-total/tasks-done from plan frontmatter
  for plan in "$target"/.sage/work/*/plan.md; do
    [ -f "$plan" ] || continue
    if grep -q "tasks-total\|tasks-done" "$plan" 2>/dev/null; then
      sed -i.bak '/^tasks-total:/d; /^tasks-done:/d' "$plan"
      rm -f "${plan}.bak"
      migrated=$((migrated + 1))
    fi
  done
  [ "$migrated" -gt 0 ] && migration_notes="${migration_notes}\n  ${CYAN}↻${RESET} Migrated $migrated plan file(s) (removed stale task count fields)"

  # Migrate journal.md → decisions.md
  if [ -f "$target/.sage/journal.md" ] && [ ! -f "$target/.sage/decisions.md" ]; then
    # Strip artifact index table, keep change log entries
    sed -n '/^## Change Log/,$ p' "$target/.sage/journal.md" | sed '1d' > /tmp/sage-journal-entries.tmp 2>/dev/null
    cat > "$target/.sage/decisions.md" << DECMD
# Decisions

Shared log for significant decisions and context.
Both the AI agent and human collaborators write here.

$(cat /tmp/sage-journal-entries.tmp 2>/dev/null)
DECMD
    rm -f /tmp/sage-journal-entries.tmp
    migration_notes="${migration_notes}\n  ${CYAN}↻${RESET} Migrated journal.md → decisions.md (artifact table removed, change log preserved)"
  fi

  # Create decisions.md if neither journal nor decisions exist
  if [ ! -f "$target/.sage/decisions.md" ]; then
    cat > "$target/.sage/decisions.md" << DECMD
# Decisions

Shared log for significant decisions and context.
Both the AI agent and human collaborators write here.

- [$(date +%Y-%m-%d)] Sage updated to v1.0.7
DECMD
    migration_notes="${migration_notes}\n  ${GREEN}✓${RESET} decisions.md created"
  fi

  if [ -n "$migration_notes" ]; then
    echo ""
    echo -e "$migration_notes"
  fi

  echo ""
  echo -e "  ${GREEN}✓${RESET} Platform files regenerated"
  echo -e "  ${GREEN}✓${RESET} .sage/ state preserved"

  ensure_hooks_wired "$target"
  ensure_codex_hooks_wired "$target" || true

  sage_complete
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: upgrade
# ═══════════════════════════════════════════════════════════════
sage_upgrade() {
  local sage_home="${SAGE_HOME:-$HOME/.sage}"

  echo ""
  echo -e "  ${BOLD}Sage — Upgrade Framework${RESET}"
  echo ""

  if [ ! -d "$sage_home/framework" ]; then
    echo -e "  ${RED}❌ Sage not installed globally.${RESET}"
    echo "  Install first:"
    echo "    curl -fsSL https://raw.githubusercontent.com/xoai/sage/main/install.sh | bash"
    exit 1
  fi

  if [ -d "$sage_home/framework/.git" ]; then
    timer_start
    step_start
    (cd "$sage_home/framework" && git pull --ff-only 2>/dev/null) &
    if spin $! "Pulling latest from GitHub..."; then
      echo -e "  ${GREEN}✓${RESET} Sage upgraded to latest"
      echo ""
      echo "  Run 'sage update' in your projects to regenerate platform files."
    else
      echo ""
      echo -e "  ${YELLOW}Could not pull updates.${RESET}"
      echo "  Try reinstalling:"
      echo "    curl -fsSL https://raw.githubusercontent.com/xoai/sage/main/install.sh | bash"
    fi
  else
    echo "  Sage was installed from a local copy (no git remote)."
    echo ""
    echo "  To upgrade, re-run the installer with the latest source:"
    echo "    curl -fsSL https://raw.githubusercontent.com/xoai/sage/main/install.sh | bash"
    echo ""
    echo "  Or download the latest release and run:"
    echo "    bash install.sh"
  fi
  echo ""
}

# ═══════════════════════════════════════════════════════════════
# SKILL MANAGEMENT (delegates to Python)
# ═══════════════════════════════════════════════════════════════

require_python() {
  if ! command -v python3 &>/dev/null; then
    echo ""
    echo -e "  ${RED}Skill management requires Python 3.8+${RESET}"
    echo "  Install Python: https://www.python.org/downloads/"
    exit 1
  fi
}

skill_manager() {
  require_python
  local manager="$SAGE_FRAMEWORK/runtime/tools/skill_manager.py"
  if [ ! -f "$manager" ]; then
    echo -e "  ${RED}❌ skill_manager.py not found at $manager${RESET}"
    exit 1
  fi
  python3 "$manager" "$@"
}

sage_find() {
  skill_manager find "$@"
}

sage_add() {
  skill_manager add "$@"
}

sage_remove() {
  skill_manager remove "$@"
}

sage_skills() {
  skill_manager list "$@"
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: setup
# ═══════════════════════════════════════════════════════════════
sage_setup() {
  local component="${1:-}"

  if [ "$component" != "memory" ]; then
    echo ""
    echo -e "  ${BOLD}Sage — Setup${RESET}"
    echo ""
    echo "  Usage: sage setup memory"
    echo ""
    return
  fi

  echo ""
  echo -e "  ${BOLD}Sage — Setup Memory${RESET}"
  echo ""
  echo "  sage-memory gives your AI agent persistent knowledge across sessions."
  echo "  It remembers architecture decisions, conventions, debugging insights,"
  echo "  and project patterns — so the agent never starts from scratch."
  echo ""
  echo -e "  ${BOLD}Step 1:${RESET} Add to your MCP config"
  echo ""

  # Detect platform
  if [ -d ".codex" ] || [ -f "$HOME/.codex/config.toml" ]; then
    echo -e "  ${CYAN}Codex${RESET} — add to .codex/config.toml or ~/.codex/config.toml:"
    echo ""
    echo '  [mcp_servers.sage-memory]'
    echo '  command = "uvx"'
    echo '  args = ["sage-memory"]'
  elif [ -d ".claude" ] || [ -f "$HOME/.claude.json" ]; then
    echo -e "  ${CYAN}Claude Code${RESET} — add to ~/.claude.json:"
    echo ""
    echo '  {'
    echo '    "mcpServers": {'
    echo '      "sage-memory": {'
    echo '        "command": "uvx",'
    echo '        "args": ["sage-memory"]'
    echo '      }'
    echo '    }'
    echo '  }'
  elif [ -d ".cursor" ]; then
    echo -e "  ${CYAN}Cursor${RESET} — add to .cursor/mcp.json:"
    echo ""
    echo '  {'
    echo '    "mcpServers": {'
    echo '      "sage-memory": {'
    echo '        "command": "uvx",'
    echo '        "args": ["sage-memory"]'
    echo '      }'
    echo '    }'
    echo '  }'
  else
    echo "  Add to your MCP client config:"
    echo ""
    echo '  {'
    echo '    "mcpServers": {'
    echo '      "sage-memory": {'
    echo '        "command": "uvx",'
    echo '        "args": ["sage-memory"]'
    echo '      }'
    echo '    }'
    echo '  }'
  fi

  echo ""
  echo -e "  ${BOLD}Step 2:${RESET} Restart your IDE"
  echo ""
  echo "  That's it. Sage will automatically search and store knowledge"
  echo "  as you work. No configuration needed."
  echo ""
  echo -e "  ${DIM}Requires uv: curl -LsSf https://astral.sh/uv/install.sh | sh${RESET}"
  echo -e "  ${DIM}More info: https://github.com/xoai/sage-memory${RESET}"
  echo ""
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: learn
# ═══════════════════════════════════════════════════════════════
sage_learn() {
  local target="${1:-.}"

  echo ""
  echo -e "  ${BOLD}Sage — Learn${RESET}"
  echo ""

  # Check if we're in a Sage project
  if [ ! -d "sage/skills" ] && [ ! -d ".sage" ]; then
    echo -e "  ${RED}❌ No Sage project found here.${RESET}"
    echo "  Run this from a Sage project directory."
    exit 1
  fi

  if [ "$target" = "." ]; then
    echo -e "  ${CYAN}Broad scan:${RESET} learning the whole project"
  else
    if [ ! -e "$target" ]; then
      echo -e "  ${RED}❌ Target not found: $target${RESET}"
      exit 1
    fi
    echo -e "  ${CYAN}Deep dive:${RESET} $target"
  fi

  echo ""
  echo "  This command works inside your AI agent (Claude Code, Antigravity, Codex)."
  echo "  Open this project in your IDE, then tell the agent:"
  echo ""

  if [ "$target" = "." ]; then
    echo -e "    ${BOLD}\"Learn this project. Do a broad scan and store${RESET}"
    echo -e "    ${BOLD} what you learn in memory.\"${RESET}"
  else
    echo -e "    ${BOLD}\"Learn $target. Do a deep dive and store${RESET}"
    echo -e "    ${BOLD} what you learn in memory.\"${RESET}"
  fi

  echo ""
  echo "  The agent will follow the memory skill\'s learn workflow:"
  echo "    1. Scan structure and key files"
  echo "    2. Identify patterns, conventions, architecture"
  echo "    3. Store focused memories in sage-memory"
  echo "    4. Generate knowledge report → .sage/docs/memory-{name}.md"
  echo ""
  echo -e "  ${DIM}Requires sage-memory MCP server. Setup: https://github.com/xoai/sage-memory${RESET}"
  echo ""
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: status
# ═══════════════════════════════════════════════════════════════
# Render-stub pattern: each enforcement layer has a dedicated render
# function. M0 ships placeholders; M1 fills L4 + framework root, M2
# fills L5, M3 fills Skills.
#
# Order is fixed (deterministic for diffability):
#   framework_root → profile → L1 → L2 → L4 → L5 → skills
#
# Each render_*() function MUST:
#   - print exactly one logical section (header + body),
#   - end with a blank line,
#   - never exit non-zero (status is informational only — exit codes
#     reserved for hard config errors, see exit-code map below).
#
# Exit codes:
#   0 — status rendered successfully (any individual layer state).
#   2 — fatal: not in a sage project (no .sage/ and no SKILL.md tree).
#   3 — reserved for future "any layer MISCONFIGURED" mapping (M1+).

_render_framework_root() {
  printf "Framework root:  %s\n" "${SAGE_FRAMEWORK:-<unresolved>}"
  printf "Profile:         %s  ${DIM}(%s)${RESET}\n" \
    "${SAGE_PROFILE:-upstream}" \
    "${SAGE_PROFILE_SOURCE:-default}"
  echo ""
}

_render_l1_section() {
  echo "L1 — AGENTS.md:                <not yet implemented>"
  echo ""
}

_render_l2_section() {
  echo "L2 — Workflow PREAMBLE:        <not yet implemented>"
  echo ""
}

_render_l4_section() {
  local target="${SAGE_STATUS_TARGET:-$(pwd)}"
  local config="$target/.codex/config.toml"
  local hooks_json="$target/.codex/hooks.json"
  local state="" hint=""

  if [ ! -f "$config" ]; then
    state="N/A"
    hint="no .codex/config.toml — Codex platform not in use"
  elif ! codex_hooks_enabled "$target"; then
    state="DISABLED"
    hint="[features].codex_hooks not set to true — opt-in disabled"
  else
    # codex_hooks=true; classify based on hooks.json + .sh files
    local fw_count=0 sh_count=0 shadow=0 missing_template=0
    local hooks_dir="$target/.codex/hooks"
    if [ -d "$hooks_dir" ]; then
      for f in "$hooks_dir"/*.sh; do
        [ -f "$f" ] || continue
        local h
        h=$(shasum -a 256 "$f" 2>/dev/null | cut -d" " -f1)
        if [ -n "$h" ] && codex_hook_known_hash "$h"; then
          sh_count=$((sh_count + 1))
        elif [ -n "$h" ]; then
          shadow=$((shadow + 1))
        fi
      done
    fi
    if [ -f "$hooks_json" ] && command -v python3 >/dev/null 2>&1; then
      fw_count=$(python3 - "$hooks_json" <<'PYEOF' 2>/dev/null || echo 0
import json, sys
KNOWN = ("session-start.sh", "pre-prompt.sh", "pre-bash.sh", "post-bash.sh")
try:
    with open(sys.argv[1]) as f:
        data = json.load(f)
except Exception:
    print(0); sys.exit(0)
n = 0
for groups in (data.get("hooks") or {}).values():
    for g in groups or []:
        for h in g.get("hooks") or []:
            cmd = h.get("command", "") or ""
            if ".codex/hooks/" in cmd and any(k in cmd for k in KNOWN):
                n += 1
                break
print(n)
PYEOF
)
    fi
    if [ "$shadow" -gt 0 ]; then
      state="MISCONFIGURED"
      hint="$shadow shadow file(s) in .codex/hooks/ — run sage update to surface"
    elif [ "$fw_count" -gt 0 ] && [ "$sh_count" -gt 0 ]; then
      state="ACTIVE"
      hint="$fw_count framework entr(y/ies) wired in hooks.json; $sh_count script(s) on disk"
    else
      state="DORMANT"
      hint="codex_hooks=true but framework hooks not wired — run: sage update"
    fi
  fi

  printf "L4 — Codex hooks:              %s\n" "$state"
  [ -n "$hint" ] && printf "  ${DIM}%s${RESET}\n" "$hint"
  echo ""
}

_render_l5_section() {
  local target="${SAGE_STATUS_TARGET:-$(pwd)}"
  local state="" hint=""

  if [ ! -d "$target/.git" ]; then
    state="NOT A REPO"
    hint="no .git directory — pre-commit gate cannot be wired"
  else
    local hooks_path
    hooks_path=$(cd "$target" && git config --get core.hooksPath 2>/dev/null || true)
    if [ -z "$hooks_path" ]; then
      state="NOT INITIALIZED"
      hint="git config core.hooksPath unset — run: sage init"
    elif [ "$hooks_path" = ".githooks" ] || [ "$hooks_path" = "$target/.githooks" ]; then
      if [ -x "$target/.githooks/pre-commit" ]; then
        state="ACTIVE"
        hint="core.hooksPath=.githooks; pre-commit script on disk"
      else
        state="DORMANT"
        hint="core.hooksPath=.githooks but pre-commit missing — run: sage init"
      fi
    else
      local detect framework custom_path
      detect=$(detect_existing_hooks_framework "$target")
      framework=$(printf '%s' "$detect" | cut -f1)
      custom_path=$(printf '%s' "$detect" | cut -f2)
      state="DORMANT (custom)"
      if [ -n "$framework" ] && [ "$framework" != "none" ]; then
        hint="core.hooksPath=$hooks_path ($framework detected) — run: sage init --force-githooks to override"
      else
        hint="core.hooksPath=$hooks_path (custom) — run: sage init --force-githooks to override"
      fi
    fi
  fi

  printf "L5 — Pre-commit gate:          %s\n" "$state"
  [ -n "$hint" ] && printf "  ${DIM}%s${RESET}\n" "$hint"
  echo ""
}

_render_skills_section() {
  local target="${SAGE_STATUS_TARGET:-$(pwd)}"
  local skills_dir="$target/.agents/skills"
  local state="" hint=""

  if [ ! -d "$skills_dir" ]; then
    state="N/A"
    hint="no .agents/skills/ — Codex platform not deployed"
    printf "Skills (behavioral isolation): %s\n" "$state"
    [ -n "$hint" ] && printf "  ${DIM}%s${RESET}\n" "$hint"
    echo ""
    return 0
  fi

  # Classify each deployed skill: workflow (no yaml) vs direct (yaml expected).
  # `tier:` from SKILL.md is the source of truth — yaml may be stale.
  local total_direct=0 yaml_count=0 workflow=0
  local d skill_md
  for d in "$skills_dir"/*/; do
    [ -d "$d" ] || continue
    skill_md="$d/SKILL.md"
    [ -f "$skill_md" ] || continue
    local tier
    tier=$(awk '
      /^---$/ { fm=!fm; next }
      fm && /^tier:/ {
        sub(/^tier:[[:space:]]*/, "")
        gsub(/["\047]/, "")
        sub(/[[:space:]]+$/, "")
        print; exit
      }
    ' "$skill_md")
    if [ "$tier" = "workflow" ]; then
      workflow=$((workflow + 1))
    else
      total_direct=$((total_direct + 1))
      [ -f "$d/agents/openai.yaml" ] && yaml_count=$((yaml_count + 1))
    fi
  done

  if [ "$total_direct" -eq 0 ] && [ "$workflow" -eq 0 ]; then
    state="EMPTY"
    hint="no skills found in .agents/skills/ — run: sage update"
  elif [ "$total_direct" -eq 0 ]; then
    state="WORKFLOW-ONLY"
    hint="$workflow workflow skill(s); no direct skills deployed"
  elif [ "$yaml_count" -eq "$total_direct" ]; then
    state="ACTIVE"
    hint="$yaml_count/$total_direct direct skills isolated; $workflow workflow skill(s) reactive"
  elif [ "$yaml_count" -eq 0 ]; then
    state="DORMANT"
    hint="$total_direct direct skills deployed without isolation yaml — run: sage update"
  else
    state="PARTIAL"
    hint="$yaml_count/$total_direct direct skills isolated — run: sage update to refresh"
  fi

  printf "Skills (behavioral isolation): %s\n" "$state"
  [ -n "$hint" ] && printf "  ${DIM}%s${RESET}\n" "$hint"
  echo ""
}

sage_status() {
  SAGE_STATUS_TARGET="$(pwd)"
  echo ""
  echo -e "  ${BOLD}Sage status${RESET}  ${DIM}(${SAGE_STATUS_TARGET})${RESET}"
  echo ""
  _render_framework_root
  _render_l1_section
  _render_l2_section
  _render_l4_section
  _render_l5_section
  _render_skills_section
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: help
# ═══════════════════════════════════════════════════════════════
sage_help() {
  echo ""
  echo -e "${BOLD}Sage${RESET} — An intelligent skills framework for AI agents"
  echo ""
  echo "Project commands:"
  echo "  sage new <n>                  Create a new project with Sage"
  echo "  sage init [--prefix]          Add Sage to the current directory"
  echo "  sage update                   Regenerate platform files"
  echo "  sage upgrade                  Update Sage to the latest version"
  echo "  sage learn [path]             Learn a codebase or module"
  echo "  sage setup memory             Configure persistent memory"
  echo "  sage status                   Show enforcement layer state (L1-L5)"
  echo ""
  echo "Skill management (powered by skills.sh):"
  echo "  sage find <query>                Search skills.sh catalog"
  echo "  sage add <source>                Install skills from owner/repo, URL, or path"
  echo "  sage add <source> --skill <n>    Install a specific skill from a repo"
  echo "  sage add <source> --all          Install all skills from a repo"
  echo "  sage remove <skill>              Remove a skill from project"
  echo "  sage skills                      List installed skills"
  echo "  sage update [target]             Update community skills"
  echo ""
  echo "  sage help                        Show this help"
  echo ""
  echo "Flags:"
  echo "  --prefix                         Namespace commands as sage:build, sage:fix, etc."
  echo "  --preset <name>                  Set constitution preset (base|startup|enterprise|opensource)"
  echo "  --platform <names>               claude-code, antigravity, codex, or comma-separated combinations"
  echo "  --self-host                      Reuse the local framework checkout in place (framework repo only)"
  echo "  --force-githooks                 Override existing pre-commit framework (Husky/lefthook/etc.) with .githooks"
  echo ""
  echo "Examples:"
  echo "  sage new my-app --platform codex                  # Create a Codex-native Sage project"
  echo "  sage init --platform claude-code,codex --prefix   # Add Sage for Claude Code + Codex"
  echo "  sage init --self-host --platform claude-code,codex # Self-host the framework repo on this branch"
  echo "  sage learn                                        # Broad scan of whole project"
  echo "  sage learn src/billing/                           # Deep dive into a module"
  echo "  sage find react                                   # Search skills.sh for React skills"
  echo "  sage add vercel-labs/agent-skills               # Browse + pick skills"
  echo "  sage add vercel-labs/agent-skills --skill react  # Install specific skill"
  echo "  sage add ./my-local-skills                      # Install from local path"
  echo ""
}

# ═══════════════════════════════════════════════════════════════
# MAIN
# ═══════════════════════════════════════════════════════════════
COMMAND="${1:-}"
shift 2>/dev/null || true

# Parse flags from remaining args
PRESET_FLAG=""
PLATFORM_FLAG=""
PREFIX_FLAG=""
SELF_HOST_FLAG=""
FORCE_GITHOOKS_FLAG=""
REMAINING_ARGS=()
for arg in "$@"; do
  case "$arg" in
    --preset=*) PRESET_FLAG="${arg#--preset=}" ;;
    --preset)   PRESET_FLAG="__NEXT__" ;;
    --platform=*) PLATFORM_FLAG="${arg#--platform=}" ;;
    --platform)  PLATFORM_FLAG="__NEXT__" ;;
    --prefix)   PREFIX_FLAG="true" ;;
    --self-host) SELF_HOST_FLAG="true" ;;
    --force-githooks) FORCE_GITHOOKS_FLAG="true" ;;
    *)
      if [ "$PRESET_FLAG" = "__NEXT__" ]; then
        PRESET_FLAG="$arg"
      elif [ "$PLATFORM_FLAG" = "__NEXT__" ]; then
        PLATFORM_FLAG="$arg"
      else
        REMAINING_ARGS+=("$arg")
      fi
      ;;
  esac
done
set -- ${REMAINING_ARGS[@]+"${REMAINING_ARGS[@]}"}

# ── First-run nudge for unwired hooks ──
# Skip when the user is running a command that itself wires hooks
# (init/update/install-hooks) or that does not imply working in a
# project (help). Skip entirely when SAGE_HOOKS_QUIET=1.
_should_nudge_hooks() {
  case "${1:-}" in
    init|update|install-hooks|status|help|--help|-h|"") return 1 ;;
  esac
  [ "${SAGE_HOOKS_QUIET:-}" = "1" ] && return 1
  local repo
  repo=$(git rev-parse --show-toplevel 2>/dev/null || true)
  [ -n "$repo" ] || return 1
  [ -f "$repo/.githooks/pre-commit" ] || return 1
  local current
  current=$(git -C "$repo" config --get core.hooksPath 2>/dev/null || true)
  [ "$current" != ".githooks" ]
}

_nudge_hooks_once() {
  # Marker per-repo so the nudge fires at most once per 60 seconds per
  # shell session. Uses BSD stat (-f %m) on macOS, GNU stat (-c %Y)
  # everywhere else.
  local repo hash marker mtime now age
  repo=$(git rev-parse --show-toplevel 2>/dev/null || true)
  [ -n "$repo" ] || return 0
  hash=$(printf '%s' "$repo" | shasum -a 256 2>/dev/null | cut -c1-12)
  [ -n "$hash" ] || hash="default"
  marker="/tmp/sage-hooks-nudge.$hash"
  now=$(date +%s)
  if [ -f "$marker" ]; then
    mtime=$(stat -f %m "$marker" 2>/dev/null || stat -c %Y "$marker" 2>/dev/null || echo "0")
    age=$(( now - mtime ))
    [ "$age" -lt 60 ] && return 0
  fi
  touch "$marker"
  printf '%bSage: hooks not wired in this clone. Run: sage install-hooks%b\n' \
    "$DIM" "$RESET" >&2
}

if _should_nudge_hooks "$COMMAND"; then
  _nudge_hooks_once
fi

case "$COMMAND" in
  new)              sage_new "$@" ;;
  init)             sage_init ;;
  update)           sage_update ;;
  upgrade)          sage_upgrade ;;
  install-hooks)    sage_install_hooks ;;
  learn)            sage_learn "$@" ;;
  setup)            sage_setup "$@" ;;
  find)             sage_find "$@" ;;
  add)              sage_add "$@" ;;
  remove)           sage_remove "$@" ;;
  skills)           sage_skills "$@" ;;
  status)           sage_status "$@" ;;
  help|--help|-h)   sage_help ;;
  "")               sage_help ;;
  *)
    echo -e "${RED}Unknown command: $COMMAND${RESET}"
    sage_help
    exit 1
    ;;
esac
