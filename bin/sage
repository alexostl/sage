#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════
# Sage CLI
#
# Usage:
#   sage new <name>     Create a new project with Sage
#   sage init           Add Sage to the current directory
#   sage update         Regenerate platform files
#   sage upgrade        Update Sage to the latest version
#   sage help           Show available commands
# ═══════════════════════════════════════════════════════════════
set -euo pipefail

# ── Colors ──
BOLD='\033[1m'
GREEN='\033[32m'
YELLOW='\033[33m'
CYAN='\033[36m'
RED='\033[31m'
DIM='\033[2m'
RESET='\033[0m'

# ── Rich output helpers ──
SAGE_START_TIME=""
STEP_START_TIME=""

# macOS date doesn't support %N — outputs literal "N" instead of failing
_sage_now() {
  local t
  t=$(date +%s%N 2>/dev/null || date +%s)
  # Strip non-digits (macOS outputs "1774343489N")
  t="${t//[!0-9]/}"
  # If length <= 10, it's seconds only — no nanosecond support
  if [ ${#t} -le 10 ]; then
    echo "${t}000000000"
  else
    echo "$t"
  fi
}

timer_start() { SAGE_START_TIME=$(_sage_now); }
step_start()  { STEP_START_TIME=$(_sage_now); }

elapsed_ms() {
  local now start
  now=$(_sage_now)
  start="${1:-$STEP_START_TIME}"
  echo $(( (now - start) / 1000000 ))
}

fmt_time() {
  local ms="$1"
  if [ "$ms" -lt 1000 ]; then
    echo "${ms}ms"
  else
    local s=$((ms / 1000))
    local rem=$((ms % 1000 / 100))
    echo "${s}.${rem}s"
  fi
}

section() {
  echo ""
  echo -e "  ${BOLD}┌─ $1${RESET}"
}

section_end() {
  echo -e "  ${BOLD}│${RESET}"
}

step_ok() {
  local ms
  ms=$(elapsed_ms "$STEP_START_TIME")
  local time_str
  time_str=$(fmt_time "$ms")
  printf "  │  ${GREEN}✓${RESET} %-42s ${DIM}%s${RESET}\n" "$1" "$time_str"
  step_start
}

step_ok_notimed() {
  echo -e "  │  ${GREEN}✓${RESET} $1"
}

step_warn() {
  echo -e "  │  ${YELLOW}⚠${RESET} $1"
}

step_fail() {
  echo -e "  │  ${RED}✗${RESET} $1"
}

step_info() {
  echo -e "  │  ${CYAN}↻${RESET} $1"
}

sage_complete() {
  local total_ms
  total_ms=$(elapsed_ms "$SAGE_START_TIME")
  local time_str
  time_str=$(fmt_time "$total_ms")
  echo -e "  ${BOLD}└─ Complete${RESET}  ${DIM}${time_str} total${RESET}"
  echo ""
}

spin() {
  local pid=$1 msg="${2:-Working...}"
  # Non-interactive: just wait silently
  if [ ! -t 1 ]; then
    wait "$pid" 2>/dev/null
    return $?
  fi
  local chars='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
  while kill -0 "$pid" 2>/dev/null; do
    for i in $(seq 0 $((${#chars} - 1))); do
      kill -0 "$pid" 2>/dev/null || break
      printf "\r  ${DIM}${chars:$i:1} %s${RESET}" "$msg"
      sleep 0.08
    done
  done
  printf "\r                                                       \r"
  wait "$pid" 2>/dev/null
  return $?
}

# ── Resolve framework source ──
# Priority: 1) script's own directory  2) SAGE_HOME env  3) ~/.sage/framework
resolve_framework() {
  # Local checkout — script lives in bin/ inside the framework
  local script_dir
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  local parent_dir="$(dirname "$script_dir")"

  if [ -d "$parent_dir/core" ] && [ -d "$parent_dir/skills" ]; then
    SAGE_FRAMEWORK="$parent_dir"
    return
  fi

  # Global install
  if [ -n "${SAGE_HOME:-}" ] && [ -d "$SAGE_HOME/framework/core" ]; then
    SAGE_FRAMEWORK="$SAGE_HOME/framework"
    return
  fi

  if [ -d "$HOME/.sage/framework/core" ]; then
    SAGE_FRAMEWORK="$HOME/.sage/framework"
    return
  fi

  echo -e "${RED}❌ Cannot find Sage framework.${RESET}"
  echo ""
  echo "  Install Sage first:"
  echo "    curl -fsSL https://raw.githubusercontent.com/xoai/sage/main/install.sh | bash"
  exit 1
}

resolve_framework

DECISIONS_LOG_LIB="$SAGE_FRAMEWORK/runtime/platforms/codex/hooks/lib/decisions_log.sh"
if [ -f "$DECISIONS_LOG_LIB" ]; then
  # shellcheck source=/dev/null
  . "$DECISIONS_LOG_LIB"
fi

canonical_dir() {
  local dir="$1"
  [ -d "$dir" ] || return 1
  (cd "$dir" && pwd -P)
}

is_framework_repo() {
  local dir="${1:-}"
  [ -f "$dir/core/registry.yaml" ] && [ -d "$dir/core/capabilities" ]
}

record_framework_source() {
  local target="$1"
  local source="$2"
  local marker="$target/sage/.sage-framework-source"
  local current=""
  local resolved_source=""

  [ -d "$target/sage" ] || return 0

  current=$(canonical_dir "$target/sage" 2>/dev/null || true)
  resolved_source=$(canonical_dir "$source" 2>/dev/null || true)
  [ -n "$resolved_source" ] || return 0

  if [ "$resolved_source" != "$current" ]; then
    printf "%s\n" "$resolved_source" > "$marker"
  else
    rm -f "$marker"
  fi
}

ensure_framework_entrypoint() {
  local target="$1"
  [ -f "$target/sage/bin/sage" ] || return 0
  chmod +x "$target/sage/bin/sage"
}

resolve_update_source() {
  local target="$1"
  local current="$target/sage"
  local current_resolved=""
  local candidate=""
  local marker="$current/.sage-framework-source"

  current_resolved=$(canonical_dir "$current" 2>/dev/null || true)

  candidate=$(canonical_dir "${SAGE_FRAMEWORK:-}" 2>/dev/null || true)
  if [ -n "$candidate" ] && [ "$candidate" != "$current_resolved" ]; then
    printf "%s\n" "$candidate"
    return 0
  fi

  if [ -f "$marker" ]; then
    candidate=$(head -n 1 "$marker" 2>/dev/null || true)
    candidate=$(canonical_dir "$candidate" 2>/dev/null || true)
    if [ -n "$candidate" ] && [ "$candidate" != "$current_resolved" ]; then
      printf "%s\n" "$candidate"
      return 0
    fi
  fi

  if [ -n "${SAGE_HOME:-}" ] && [ -d "$SAGE_HOME/framework/core" ]; then
    candidate=$(canonical_dir "$SAGE_HOME/framework" 2>/dev/null || true)
    if [ -n "$candidate" ] && [ "$candidate" != "$current_resolved" ]; then
      printf "%s\n" "$candidate"
      return 0
    fi
  fi

  if [ -d "$HOME/.sage/framework/core" ]; then
    candidate=$(canonical_dir "$HOME/.sage/framework" 2>/dev/null || true)
    if [ -n "$candidate" ] && [ "$candidate" != "$current_resolved" ]; then
      printf "%s\n" "$candidate"
      return 0
    fi
  fi

  return 1
}

# ═══════════════════════════════════════════════════════════════
# SHARED FUNCTIONS
# ═══════════════════════════════════════════════════════════════

prune_framework_copy() {
  local sage_dir="$1"
  rm -rf "$sage_dir/.git" "$sage_dir/.github" "$sage_dir/.tmp"
  rm -rf "$sage_dir/.sage" "$sage_dir/.sage-memory"
  rm -rf "$sage_dir/.claude" "$sage_dir/.codex" "$sage_dir/.agents"
  rm -rf "$sage_dir/target"
  find "$sage_dir" -name node_modules -type d -prune -exec rm -rf {} + 2>/dev/null || true
  find "$sage_dir" -name __pycache__ -type d -prune -exec rm -rf {} + 2>/dev/null || true
  find "$sage_dir" \( -name '*.pyc' -o -name '.DS_Store' \) -type f -delete 2>/dev/null || true
  rm -f "$sage_dir/.DS_Store"
}

copy_framework_distribution() {
  local source="$1"
  local dest="$2"
  mkdir -p "$dest"
  (
    cd "$source" || exit 1
    tar \
      --exclude './.git' \
      --exclude './.github' \
      --exclude './.sage' \
      --exclude './.sage-memory' \
      --exclude './.claude' \
      --exclude './.codex' \
      --exclude './.agents' \
      --exclude './.tmp' \
      --exclude './target' \
      --exclude './target/sage' \
      --exclude './.DS_Store' \
      --exclude './.sage/work/*/qa/run-*' \
      --exclude '*/node_modules' \
      --exclude '*/__pycache__' \
      --exclude '*.pyc' \
      -cf - .
  ) | (
    cd "$dest" || exit 1
    tar -xf -
  )
}

ask_choice() {
  local prompt="$1"
  shift
  local options=("$@")
  local count=${#options[@]}

  echo "" >&2
  echo -e "  ${BOLD}$prompt${RESET}" >&2
  echo "" >&2
  for i in "${!options[@]}"; do
    echo "    $((i + 1))) ${options[$i]}" >&2
  done
  echo "" >&2
  printf "  Choice [1-$count]: " >&2
  read -r choice

  if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt "$count" ]; then
    choice=1
  fi
  echo "$choice"
}

platform_has() {
  local needle="$1"
  case ",${PLATFORM:-}," in
    *,"$needle",*) return 0 ;;
    *) return 1 ;;
  esac
}

platform_append() {
  local platform_name="$1"
  if [ -z "${PLATFORM:-}" ]; then
    PLATFORM="$platform_name"
    return
  fi
  platform_has "$platform_name" || PLATFORM="${PLATFORM},${platform_name}"
}

platform_label() {
  local value="${1:-${PLATFORM:-}}"
  if [ -z "$value" ]; then
    echo "none"
    return
  fi
  echo "$value" | sed 's/,/, /g'
}

normalize_platform_value() {
  local raw="${1:-}"
  local compact="${raw//[[:space:]]/}"
  local expanded=""
  local normalized=()
  local token
  local valid

  [ -n "$compact" ] || return 1

  IFS=',' read -r -a requested <<< "$compact"
  for token in "${requested[@]}"; do
    case "$token" in
      both)
        if [ -n "$expanded" ]; then
          expanded="$expanded,claude-code,antigravity"
        else
          expanded="claude-code,antigravity"
        fi
        ;;
      claude-code|antigravity|codex)
        if [ -n "$expanded" ]; then
          expanded="$expanded,$token"
        else
          expanded="$token"
        fi
        ;;
      *)
        return 1
        ;;
    esac
  done

  IFS=',' read -r -a requested <<< "$expanded"
  for valid in claude-code antigravity codex; do
    for token in "${requested[@]}"; do
      if [ "$token" = "$valid" ]; then
        normalized+=("$valid")
        break
      fi
    done
  done

  [ "${#normalized[@]}" -gt 0 ] || return 1

  local joined=""
  for token in "${normalized[@]}"; do
    if [ -n "$joined" ]; then
      joined="$joined,$token"
    else
      joined="$token"
    fi
  done

  echo "$joined"
}

select_platform() {
  local target="$1"
  PLATFORM=""

  if [ -n "${PLATFORM_FLAG:-}" ]; then
    if ! PLATFORM="$(normalize_platform_value "$PLATFORM_FLAG")"; then
      echo ""
      echo -e "  ${RED}❌ Invalid --platform value: ${PLATFORM_FLAG}${RESET}"
      echo "  Valid values: claude-code, antigravity, codex"
      echo "  You can combine them with commas, e.g. claude-code,codex"
      echo "  Legacy alias supported: both -> claude-code,antigravity"
      exit 1
    fi
    echo -e "  ${GREEN}Platform:${RESET} $(platform_label)"
    return
  fi

  # Auto-detect from existing files
  local has_agent=false has_claude=false has_codex=false
  [ -d "$target/.agent" ] && has_agent=true
  [ -f "$target/GEMINI.md" ] && has_agent=true
  [ -d "$target/.claude" ] && has_claude=true
  # Check if CLAUDE.md is Sage-generated
  if [ -f "$target/CLAUDE.md" ] && head -1 "$target/CLAUDE.md" | grep -q "Sage"; then
    has_claude=true
  fi
  if [ -d "$target/.agents/skills/sage-navigator" ] || [ -f "$target/.codex/config.toml" ]; then
    has_codex=true
  fi
  if [ -f "$target/AGENTS.md" ] && head -1 "$target/AGENTS.md" | grep -q "Sage"; then
    has_codex=true
  fi

  [ "$has_claude" = true ] && platform_append "claude-code"
  [ "$has_agent" = true ] && platform_append "antigravity"
  [ "$has_codex" = true ] && platform_append "codex"

  if [ -n "$PLATFORM" ]; then
    echo -e "  ${GREEN}Detected:${RESET} $(platform_label)"
    return
  fi

  # Ask interactively
  if [ -t 0 ]; then
    local choice
    choice=$(ask_choice \
      "Which platform are you using?" \
      "Claude Code" \
      "Antigravity" \
      "Codex" \
      "Claude Code + Antigravity" \
      "Claude Code + Codex" \
      "Antigravity + Codex" \
      "All three")
    case "$choice" in
      2) PLATFORM="antigravity" ;;
      3) PLATFORM="codex" ;;
      4) PLATFORM="claude-code,antigravity" ;;
      5) PLATFORM="claude-code,codex" ;;
      6) PLATFORM="antigravity,codex" ;;
      7) PLATFORM="claude-code,antigravity,codex" ;;
      *) PLATFORM="claude-code" ;;
    esac
  else
    PLATFORM="claude-code"
  fi
}

detect_stack() {
  local target="$1"
  DETECTED_STACK=""

  if [ -f "$target/package.json" ]; then
    local pkg="$target/package.json"
    grep -q '"next"' "$pkg" 2>/dev/null && DETECTED_STACK="$DETECTED_STACK next"
    grep -q '"react"' "$pkg" 2>/dev/null && DETECTED_STACK="$DETECTED_STACK react"
    grep -q '"vue"' "$pkg" 2>/dev/null && DETECTED_STACK="$DETECTED_STACK vue"
    grep -q '"svelte"' "$pkg" 2>/dev/null && DETECTED_STACK="$DETECTED_STACK svelte"
    grep -q '"react-native"' "$pkg" 2>/dev/null && DETECTED_STACK="$DETECTED_STACK react-native"
    grep -q '"@supabase"' "$pkg" 2>/dev/null && DETECTED_STACK="$DETECTED_STACK supabase"
    grep -q '"firebase"' "$pkg" 2>/dev/null && DETECTED_STACK="$DETECTED_STACK firebase"
    grep -q '"express"\|"fastify"\|"hono"' "$pkg" 2>/dev/null && DETECTED_STACK="$DETECTED_STACK node-api"
  fi
  [ -f "$target/pubspec.yaml" ] && DETECTED_STACK="$DETECTED_STACK flutter"
  [ -f "$target/requirements.txt" ] || [ -f "$target/pyproject.toml" ] && DETECTED_STACK="$DETECTED_STACK python"
  [ -f "$target/go.mod" ] && DETECTED_STACK="$DETECTED_STACK go"
  [ -f "$target/Cargo.toml" ] && DETECTED_STACK="$DETECTED_STACK rust"

  DETECTED_STACK=$(echo "$DETECTED_STACK" | xargs)

  if [ -z "$DETECTED_STACK" ]; then
    echo -e "  ${DIM}No stack detected${RESET}"
  else
    echo -e "  ${GREEN}Stack:${RESET} $DETECTED_STACK"
  fi
}

copy_framework() {
  local target="$1"
  if [ -d "$target/sage" ]; then
    ensure_framework_entrypoint "$target"
    echo -e "  ${GREEN}✓${RESET} sage/ already present"
  else
    copy_framework_distribution "$SAGE_FRAMEWORK" "$target/sage" &
    spin $! "Copying framework..."
    prune_framework_copy "$target/sage"
    record_framework_source "$target" "$SAGE_FRAMEWORK"
    ensure_framework_entrypoint "$target"
    echo -e "  ${GREEN}✓${RESET} sage/ copied to project"
  fi
}

select_preset() {
  local target="$1"
  SELECTED_PRESET=""

  # Check for --preset flag (set by CLI parser)
  if [ -n "${PRESET_FLAG:-}" ]; then
    case "$PRESET_FLAG" in
      base|startup|enterprise|opensource|none)
        SELECTED_PRESET="$PRESET_FLAG"
        echo -e "  ${GREEN}Preset:${RESET} $SELECTED_PRESET"
        return
        ;;
      *)
        echo -e "  ${YELLOW}Unknown preset: $PRESET_FLAG. Using base.${RESET}"
        SELECTED_PRESET="base"
        return
        ;;
    esac
  fi

  # Check if constitution already exists (re-init)
  if [ -f "$target/.sage/constitution.md" ]; then
    local existing
    existing=$(sed -n '/^extends:/s/^extends: *//p' "$target/.sage/constitution.md" 2>/dev/null)
    if [ -n "$existing" ]; then
      SELECTED_PRESET="$existing"
      echo -e "  ${GREEN}Preset:${RESET} $existing (from existing constitution)"
      return
    fi
  fi

  # Ask interactively
  if [ -t 0 ]; then
    local choice
    choice=$(ask_choice "Select a constitution preset:" \
      "base — universal engineering principles (default)" \
      "startup — ship fast, monolith first, one way to do things" \
      "enterprise — auth everywhere, audit trails, postmortems" \
      "opensource — docs mirror code, semver contract, contributor-friendly" \
      "none — base only, no preset")
    case "$choice" in
      2) SELECTED_PRESET="startup" ;;
      3) SELECTED_PRESET="enterprise" ;;
      4) SELECTED_PRESET="opensource" ;;
      5) SELECTED_PRESET="base" ;;
      *) SELECTED_PRESET="base" ;;
    esac
  else
    SELECTED_PRESET="base"
  fi
  echo -e "  ${GREEN}Preset:${RESET} $SELECTED_PRESET"
}

apply_prefix_config() {
  local config="$1/.sage/config.yaml"
  [ -f "$config" ] || return 0
  local prefix_val="false"
  [ "$PREFIX_FLAG" = "true" ] && prefix_val="true"
  if grep -q 'command_prefix:' "$config" 2>/dev/null; then
    sed -i.bak "s/^command_prefix:.*$/command_prefix: $prefix_val/" "$config" && rm -f "${config}.bak"
  else
    echo "command_prefix: $prefix_val" >> "$config"
  fi
}

create_sage_state() {
  local target="$1"
  local project_name
  project_name=$(basename "$target")
  local sage_dir="$target/.sage"
  local prefix_val="false"
  local created_state=false
  local preserved_state=false

  [ "$PREFIX_FLAG" = "true" ] && prefix_val="true"
  mkdir -p "$sage_dir/work" "$sage_dir/docs" "$sage_dir/gates/scripts"

  if [ -d "$target/.sage" ]; then
    preserved_state=true
  fi

  if [ ! -f "$sage_dir/config.yaml" ]; then
    cat > "$sage_dir/config.yaml" << YAML
sage-version: "1.0.0"
project-name: "$project_name"
platform: "${PLATFORM:-claude-code}"
constitution: "${SELECTED_PRESET:-base}"
detected-stack: [$DETECTED_STACK]
auto_review: true
auto_qa: true
independent_gate3: true
command_prefix: $prefix_val
YAML
    created_state=true
  else
    apply_prefix_config "$target"
  fi

  if [ ! -f "$sage_dir/decisions.md" ]; then
    cat > "$sage_dir/decisions.md" << MD
# Decisions

Shared log for significant decisions and context.
Both the AI agent and human collaborators write here.

- [$(date +%Y-%m-%d)] Sage initialized for $project_name
MD
    created_state=true
  fi

  if [ ! -f "$sage_dir/conventions.md" ]; then
    cat > "$sage_dir/conventions.md" << MD
# Project Conventions

Discovered by Sage on $(date +%Y-%m-%d).
The codebase-scan capability will enrich this on first run.
MD
    created_state=true
  fi

  # Gate scripts
  for script in "$SAGE_FRAMEWORK/core/gates/scripts/"*.sh; do
    [ -f "$script" ] || continue
    cp "$script" "$sage_dir/gates/scripts/"
    chmod +x "$sage_dir/gates/scripts/$(basename "$script")"
  done

  # Gate activation config
  local gate_config="$SAGE_FRAMEWORK/core/gates/_config/gate-modes.yaml"
  if [ -f "$gate_config" ]; then
    cp "$gate_config" "$sage_dir/gates/gate-modes.yaml"
  fi

  # Constitution
  if [ ! -f "$sage_dir/constitution.md" ] && [ -n "${SELECTED_PRESET:-}" ] && [ "$SELECTED_PRESET" != "base" ] && [ "$SELECTED_PRESET" != "none" ]; then
    cat > "$sage_dir/constitution.md" << CONSTMD
---
name: "$project_name"
extends: $SELECTED_PRESET
---

## Project Additions

(Add project-specific principles here)
CONSTMD
    created_state=true
  fi

  if [ "$preserved_state" = true ] && [ "$created_state" = true ]; then
    echo -e "  ${GREEN}✓${RESET} .sage/ preserved and bootstrapped (existing state)"
  elif [ "$preserved_state" = true ]; then
    echo -e "  ${GREEN}✓${RESET} .sage/ preserved (existing state)"
  else
    echo -e "  ${GREEN}✓${RESET} .sage/ initialized"
  fi
}

preflight_platform_tools() {
  if platform_has "codex"; then
    local _missing=""
    command -v jq >/dev/null 2>&1 || _missing="${_missing} jq"
    command -v yq >/dev/null 2>&1 || _missing="${_missing} yq"
    if [ -n "$_missing" ]; then
      echo -e "  ${RED}❌ Missing required tools for Codex hooks:${RESET}${_missing}"
      case "$(uname -s)" in
        Darwin) echo -e "  ${DIM}Install:${RESET} brew install$_missing" ;;
        Linux)  echo -e "  ${DIM}Install:${RESET} apt-get install$_missing  (or your distro's package manager)" ;;
        *)      echo -e "  ${DIM}Install:${RESET} install$_missing via your package manager" ;;
      esac
      exit 1
    fi
  fi
}

run_generators() {
  local target="$1"
  local sage_path="$target/sage"
  [ -d "$sage_path" ] || sage_path="$SAGE_FRAMEWORK"
  export SAGE_FRAMEWORK_DIR="$sage_path"

  if platform_has "antigravity"; then
    echo ""
    bash "$sage_path/runtime/platforms/antigravity/setup/generate-antigravity.sh" "$target"
  fi

  if platform_has "claude-code"; then
    echo ""
    bash "$sage_path/runtime/platforms/claude-code/setup/generate-claude-code.sh" "$target"
  fi

  if platform_has "codex"; then
    echo ""
    preflight_platform_tools
    SAGE_FRAMEWORK="$sage_path" bash \
      "$sage_path/runtime/platforms/codex/setup/generate-codex.sh" \
      --target "$target" --preset "${SELECTED_PRESET:-base}"
  fi

  unset SAGE_FRAMEWORK_DIR
}

print_success() {
  local target="$1"
  local project_name
  project_name=$(basename "$target")

  # Constitution info
  local preset_info="base"
  [ -n "${SELECTED_PRESET:-}" ] && [ "$SELECTED_PRESET" != "base" ] && preset_info="$SELECTED_PRESET"

  sage_complete

  # Command prefix display
  local p=""
  [ "$PREFIX_FLAG" = "true" ] && p="sage:"

  echo -e "  ${BOLD}Get started:${RESET}"
  echo ""
  if platform_has "claude-code"; then
    echo "    1. Open this project in your IDE"
    echo -e "    2. Type ${BOLD}/sage${RESET} and describe what you want to build"
    echo ""
    echo -e "  ${DIM}Commands: /${p}build  /${p}fix  /${p}architect  /${p}status  /${p}review  /${p}learn${RESET}"
  fi
  if platform_has "antigravity"; then
    echo "    1. Open this project in Antigravity"
    echo -e "    2. Type ${BOLD}/sage${RESET} and describe what you want to build"
    echo ""
    echo -e "  ${DIM}Commands: /${p}build  /${p}fix  /${p}architect  /${p}status  /${p}review  /${p}learn${RESET}"
  fi
  if platform_has "codex"; then
    echo "    1. Open this project in Codex"
    echo "    2. Use AGENTS.md and the Sage skills in .agents/skills/"
    echo ""
    echo -e "  ${DIM}Codex surfaces: AGENTS.md  .agents/skills/  .codex/config.toml${RESET}"
    echo -e "  ${DIM}Built-in helper: /review for diff-oriented review passes${RESET}"
  fi

  if [ "${SELF_HOST_FLAG:-}" = "true" ] && is_framework_repo "$target"; then
    echo ""
    echo -e "  ${DIM}Self-host mode: using the local framework checkout in place — no nested sage/ copied${RESET}"
  fi

  # Check for sage-memory
  local has_memory=false
  if [ -f "$HOME/.claude.json" ] && grep -q "sage-memory" "$HOME/.claude.json" 2>/dev/null; then
    has_memory=true
  fi
  if [ -f "$target/.claude.json" ] && grep -q "sage-memory" "$target/.claude.json" 2>/dev/null; then
    has_memory=true
  fi
  if [ -f "$target/.codex/config.toml" ] && grep -q "sage-memory" "$target/.codex/config.toml" 2>/dev/null; then
    has_memory=true
  fi

  if [ "$has_memory" = false ]; then
    echo ""
    echo -e "  ${DIM}Enable persistent memory:  sage setup memory${RESET}"
  fi

  echo ""
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: new <name>
# ═══════════════════════════════════════════════════════════════
sage_new() {
  local name="${1:-}"

  echo ""
  echo -e "  ${BOLD}Sage — New Project${RESET}"
  echo ""

  if [ -z "$name" ]; then
    printf "  Project name: " >&2
    read -r name
    if [ -z "$name" ]; then
      echo -e "  ${RED}❌ Project name is required.${RESET}"
      exit 1
    fi
  fi

  if [[ "$name" =~ [\ /\\] ]]; then
    echo -e "  ${RED}❌ Project name cannot contain spaces or slashes.${RESET}"
    exit 1
  fi

  if [ -d "$name" ]; then
    echo -e "  ${RED}❌ Directory '$name' already exists.${RESET}"
    echo "  Use 'sage init' inside it instead."
    exit 1
  fi

  echo -e "  Creating ${CYAN}$name${RESET}..."
  timer_start
  step_start

  mkdir -p "$name"
  local target
  target="$(cd "$name" && pwd)"

  select_platform "$target"
  preflight_platform_tools
  copy_framework "$target"

  # Git init
  if [ ! -d "$target/.git" ]; then
    (cd "$target" && git init -q 2>/dev/null) || true
    echo -e "  ${GREEN}✓${RESET} Git initialized"
  fi

  detect_stack "$target"
  if [ -z "${PLATFORM:-}" ]; then
    select_platform "$target"
    preflight_platform_tools
  fi
  select_preset "$target"
  create_sage_state "$target"
  run_generators "$target"
  print_success "$target"
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: init
# ═══════════════════════════════════════════════════════════════
sage_init() {
  local target
  local framework_repo=false
  target="$(pwd)"

  if is_framework_repo "$target"; then
    framework_repo=true
  fi

  # Safety: don't init inside the framework itself unless self-host mode is explicit
  if [ "$framework_repo" = true ] && [ "${SELF_HOST_FLAG:-}" != "true" ]; then
    echo ""
    echo -e "  ${RED}❌ You're inside the Sage framework directory.${RESET}"
    echo ""
    echo "  Run from your project directory instead:"
    echo "    cd /path/to/your/project"
    echo "    sage init"
    echo ""
    echo "  Private capability on this branch:"
    echo "    sage init --self-host --platform claude-code,codex"
    exit 1
  fi

  echo ""
  echo -e "  ${BOLD}Sage — Initialize Project${RESET}"
  echo ""
  echo -e "  Project: ${CYAN}$(basename "$target")${RESET}"
  echo -e "  Path:    ${DIM}$target${RESET}"
  timer_start
  step_start

  # Check if already initialized
  if [ -d "$target/.sage" ] && { [ -d "$target/sage" ] || [ "$framework_repo" = true ]; }; then
    echo -e "  ${YELLOW}Sage is already initialized in this project.${RESET}"
    echo ""
    echo "  To regenerate platform files: sage update"
    if [ "$framework_repo" = true ]; then
      echo "  To start over: remove .sage/ and generated platform files first"
    else
      echo "  To start over: remove .sage/ and sage/ first"
    fi
    echo ""
    printf "  Reinstall anyway? [y/N]: "
    read -r confirm
    if [ "$confirm" != "y" ] && [ "$confirm" != "Y" ]; then
      echo "  Cancelled."
      exit 0
    fi
    echo ""
  fi

  detect_stack "$target"
  select_platform "$target"
  preflight_platform_tools
  if [ "$framework_repo" = true ]; then
    echo -e "  ${GREEN}✓${RESET} Self-host mode enabled (reusing local framework checkout)"
  else
    copy_framework "$target"
  fi
  select_preset "$target"
  create_sage_state "$target"
  run_generators "$target"
  print_success "$target"
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: update
# ═══════════════════════════════════════════════════════════════
sage_update() {
  local target
  local update_source=""
  target="$(pwd)"

  if [ ! -d "$target/.sage" ]; then
    echo ""
    echo -e "  ${RED}❌ No Sage project found here.${RESET}"
    echo "  Run this from a directory with .sage/"
    echo "  Or run 'sage init' to set up Sage first."
    exit 1
  fi

  echo ""
  echo -e "  ${BOLD}Sage — Update Project${RESET}"
  echo ""
  echo -e "  Project: ${CYAN}$(basename "$target")${RESET}"
  timer_start
  step_start

  # Detect platform
  PLATFORM=""
  if [ -f "$target/GEMINI.md" ] || [ -d "$target/.agent" ]; then
    platform_append "antigravity"
  fi
  if [ -f "$target/CLAUDE.md" ] && head -1 "$target/CLAUDE.md" 2>/dev/null | grep -q "Sage"; then
    platform_append "claude-code"
  fi
  if [ -d "$target/.claude/commands" ]; then
    platform_append "claude-code"
  fi
  if [ -f "$target/AGENTS.md" ] && head -1 "$target/AGENTS.md" 2>/dev/null | grep -q "Sage"; then
    platform_append "codex"
  fi
  if [ -d "$target/.agents/skills/sage-navigator" ] || [ -f "$target/.codex/config.toml" ]; then
    platform_append "codex"
  fi

  if [ -z "$PLATFORM" ]; then
    echo -e "  ${YELLOW}No platform files found.${RESET}"
    echo "  Selecting platform..."
    select_platform "$target"
  else
    echo -e "  ${GREEN}Platform:${RESET} $(platform_label)"
  fi

  # Detect community skills before updating
  local community_skills=""
  if [ -f "$target/sage/skills/skills.json" ]; then
    community_skills=$(python3 -c "
import json, sys
try:
  d = json.load(open('$target/sage/skills/skills.json'))
  cs = [k for k, v in d.get('skills', {}).items() if v.get('source') != 'built-in']
  print(' '.join(cs))
except: pass
" 2>/dev/null)
  fi

  # Show what will happen
  echo ""
  echo "  This will:"
  if [ -d "$target/sage" ]; then
    echo -e "    ${CYAN}↻${RESET} Update sage/ framework to latest version"
  fi
  if platform_has "antigravity"; then
    echo -e "    ${CYAN}↻${RESET} Regenerate GEMINI.md and .agent/"
  fi
  if platform_has "claude-code"; then
    echo -e "    ${CYAN}↻${RESET} Regenerate CLAUDE.md and .claude/commands/"
  fi
  if platform_has "codex"; then
    echo -e "    ${CYAN}↻${RESET} Regenerate AGENTS.md, .agents/skills/, and .codex/config.toml"
  fi
  echo -e "    ${GREEN}✓${RESET} Preserve .sage/ project state (untouched)"
  if [ -n "$community_skills" ]; then
    echo -e "    ${GREEN}✓${RESET} Preserve community skills: $community_skills"
  fi

  echo ""
  if [ -t 0 ]; then
    printf "  [A] Proceed  |  [C] Cancel: "
    read -r confirm
    if [ "$confirm" != "A" ] && [ "$confirm" != "a" ] && [ "$confirm" != "" ]; then
      echo "  Cancelled."
      echo ""
      return
    fi
  fi

  echo ""

  # Backup community skills
  local backup_dir=""
  if [ -n "$community_skills" ]; then
    backup_dir=$(mktemp -d)
    for skill_name in $community_skills; do
      if [ -d "$target/sage/skills/$skill_name" ]; then
        cp -a "$target/sage/skills/$skill_name" "$backup_dir/"
      fi
    done
  fi

  # Update sage/ framework
  if [ -d "$target/sage" ]; then
    if ! update_source=$(resolve_update_source "$target"); then
      echo -e "  ${RED}✗${RESET} Cannot find a stable Sage framework source for update"
      echo ""
      echo "  Try one of:"
      echo "    1. Run update from an original Sage checkout"
      echo "    2. Install Sage globally so ~/.sage/framework is available"
      echo ""
      exit 1
    fi
    rm -rf "$target/sage"
    copy_framework_distribution "$update_source" "$target/sage" &
    spin $! "Updating framework..."
    prune_framework_copy "$target/sage"
    record_framework_source "$target" "$update_source"
    ensure_framework_entrypoint "$target"
    echo -e "  ${GREEN}✓${RESET} sage/ updated"
  fi

  # Restore community skills
  if [ -n "$community_skills" ] && [ -n "$backup_dir" ]; then
    for skill_name in $community_skills; do
      if [ -d "$backup_dir/$skill_name" ]; then
        cp -a "$backup_dir/$skill_name" "$target/sage/skills/"
      fi
    done
    rm -rf "$backup_dir"

    # Re-register community skills in skills.json
    python3 -c "
import json, sys
try:
  with open('$target/sage/skills/skills.json') as f:
    d = json.load(f)
  for s in '$community_skills'.split():
    if s not in d.get('skills', {}):
      d.setdefault('skills', {})[s] = {'source': 'community', 'added': '$(date +%Y-%m-%d)'}
  with open('$target/sage/skills/skills.json', 'w') as f:
    json.dump(d, f, indent=2)
except: pass
" 2>/dev/null

    echo -e "  ${GREEN}✓${RESET} Community skills preserved: $community_skills"
  fi

  # Apply --prefix flag if provided
  [ "$PREFIX_FLAG" = "true" ] && apply_prefix_config "$target"

  # Regenerate platform files
  DETECTED_STACK=""
  detect_stack "$target"
  export SAGE_UPDATE_MODE=true
  run_generators "$target"
  unset SAGE_UPDATE_MODE

  # ── Migration: clean stale patterns from previous versions ──
  local migrated=0
  local migration_notes=""

  # Remove tasks-total/tasks-done from plan frontmatter
  for plan in "$target"/.sage/work/*/plan.md; do
    [ -f "$plan" ] || continue
    if grep -q "tasks-total\|tasks-done" "$plan" 2>/dev/null; then
      sed -i.bak '/^tasks-total:/d; /^tasks-done:/d' "$plan"
      rm -f "${plan}.bak"
      migrated=$((migrated + 1))
    fi
  done
  [ "$migrated" -gt 0 ] && migration_notes="${migration_notes}\n  ${CYAN}↻${RESET} Migrated $migrated plan file(s) (removed stale task count fields)"

  # Migrate journal.md → decisions.md
  if [ -f "$target/.sage/journal.md" ] && [ ! -f "$target/.sage/decisions.md" ]; then
    # Strip artifact index table, keep change log entries
    sed -n '/^## Change Log/,$ p' "$target/.sage/journal.md" | sed '1d' > /tmp/sage-journal-entries.tmp 2>/dev/null
    cat > "$target/.sage/decisions.md" << DECMD
# Decisions

Shared log for significant decisions and context.
Both the AI agent and human collaborators write here.

$(cat /tmp/sage-journal-entries.tmp 2>/dev/null)
DECMD
    rm -f /tmp/sage-journal-entries.tmp
    migration_notes="${migration_notes}\n  ${CYAN}↻${RESET} Migrated journal.md → decisions.md (artifact table removed, change log preserved)"
  fi

  # Create decisions.md if neither journal nor decisions exist
  if [ ! -f "$target/.sage/decisions.md" ]; then
    cat > "$target/.sage/decisions.md" << DECMD
# Decisions

Shared log for significant decisions and context.
Both the AI agent and human collaborators write here.

- [$(date +%Y-%m-%d)] Sage updated to v1.0.7
DECMD
    migration_notes="${migration_notes}\n  ${GREEN}✓${RESET} decisions.md created"
  fi

  if [ -n "$migration_notes" ]; then
    echo ""
    echo -e "$migration_notes"
  fi

  echo ""
  echo -e "  ${GREEN}✓${RESET} Platform files regenerated"
  echo -e "  ${GREEN}✓${RESET} .sage/ state preserved"

  sage_complete
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: upgrade
# ═══════════════════════════════════════════════════════════════
sage_upgrade() {
  local sage_home="${SAGE_HOME:-$HOME/.sage}"

  echo ""
  echo -e "  ${BOLD}Sage — Upgrade Framework${RESET}"
  echo ""

  if [ ! -d "$sage_home/framework" ]; then
    echo -e "  ${RED}❌ Sage not installed globally.${RESET}"
    echo "  Install first:"
    echo "    curl -fsSL https://raw.githubusercontent.com/xoai/sage/main/install.sh | bash"
    exit 1
  fi

  if [ -d "$sage_home/framework/.git" ]; then
    timer_start
    step_start
    (cd "$sage_home/framework" && git pull --ff-only 2>/dev/null) &
    if spin $! "Pulling latest from GitHub..."; then
      echo -e "  ${GREEN}✓${RESET} Sage upgraded to latest"
      echo ""
      echo "  Run 'sage update' in your projects to regenerate platform files."
    else
      echo ""
      echo -e "  ${YELLOW}Could not pull updates.${RESET}"
      echo "  Try reinstalling:"
      echo "    curl -fsSL https://raw.githubusercontent.com/xoai/sage/main/install.sh | bash"
    fi
  else
    echo "  Sage was installed from a local copy (no git remote)."
    echo ""
    echo "  To upgrade, re-run the installer with the latest source:"
    echo "    curl -fsSL https://raw.githubusercontent.com/xoai/sage/main/install.sh | bash"
    echo ""
    echo "  Or download the latest release and run:"
    echo "    bash install.sh"
  fi
  echo ""
}

# ═══════════════════════════════════════════════════════════════
# SKILL MANAGEMENT (delegates to Python)
# ═══════════════════════════════════════════════════════════════

require_python() {
  if ! command -v python3 &>/dev/null; then
    echo ""
    echo -e "  ${RED}Skill management requires Python 3.8+${RESET}"
    echo "  Install Python: https://www.python.org/downloads/"
    exit 1
  fi
}

skill_manager() {
  require_python
  local manager="$SAGE_FRAMEWORK/runtime/tools/skill_manager.py"
  if [ ! -f "$manager" ]; then
    echo -e "  ${RED}❌ skill_manager.py not found at $manager${RESET}"
    exit 1
  fi
  python3 "$manager" "$@"
}

sage_find() {
  skill_manager find "$@"
}

sage_add() {
  skill_manager add "$@"
}

sage_remove() {
  skill_manager remove "$@"
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: doctor (Codex port diagnostic, read-only per spec §7.2)
# ═══════════════════════════════════════════════════════════════
# Each check prints one line: ✓ / ⚠ / ✗  <id>  <message>
# Followed (warn/fail only) by:           Fix: <command>
#
# The only file `sage doctor` writes is `.sage/.doctor-cursor`.
# Exit 0 when no fail; non-zero when any fail.
sage_doctor() {
  local target
  target="$(pwd)"

  if [ ! -d "$target/.sage" ] && [ ! -d "$target/.codex" ]; then
    echo ""
    echo -e "  ${RED}❌ Nie znaleziono układu Sage/Codex w tym katalogu.${RESET}"
    echo "  Najpierw uruchom 'sage init --platform codex'."
    exit 1
  fi

  echo ""
  echo -e "  ${BOLD}Sage doctor — kontrole portu Codex${RESET}"
  echo ""

  local pass_n=0 warn_n=0 fail_n=0

  _doctor_pass() {
    echo -e "    ${GREEN}✓${RESET}  $1  ${DIM}$2${RESET}"
    pass_n=$((pass_n + 1))
  }
  _doctor_warn() {
    echo -e "    ${YELLOW}⚠${RESET}  $1  $2"
    [ -n "${3:-}" ] && echo -e "         ${DIM}Fix:${RESET} $3"
    warn_n=$((warn_n + 1))
  }
  _doctor_fail() {
    echo -e "    ${RED}✗${RESET}  $1  $2"
    [ -n "${3:-}" ] && echo -e "         ${DIM}Fix:${RESET} $3"
    fail_n=$((fail_n + 1))
  }
  _doctor_info() {
    echo -e "    ${CYAN}↻${RESET}  $1  $2"
  }
  _doctor_cursor_epoch() {
    local cursor_file="$1"
    local raw
    [ -f "$cursor_file" ] || { echo 0; return; }
    raw="$(cat "$cursor_file" 2>/dev/null || true)"
    if printf '%s' "$raw" | grep -q '^[[:space:]]*{'; then
      if command -v jq >/dev/null 2>&1; then
        local epoch
        epoch="$(printf '%s' "$raw" | jq -r '.last_checked_epoch // empty' 2>/dev/null || true)"
        case "$epoch" in
          ''|*[!0-9]*) echo 0 ;;
          *) echo "$epoch" ;;
        esac
        return
      fi
      echo 0
      return
    fi
    raw="$(printf '%s' "$raw" | tr -d '[:space:]')"
    case "$raw" in
      ''|*[!0-9]*) echo 0 ;;
      *) echo "$raw" ;;
    esac
  }

  # ── E1 — Codex CLI present + version ──
  local codex_ver=""
  if command -v codex >/dev/null 2>&1; then
    codex_ver="$(codex --version 2>/dev/null | head -1)"
    if [ -n "$codex_ver" ]; then
      _doctor_pass "E1" "Codex CLI present ($codex_ver)"
    else
      _doctor_warn "E1" "Codex CLI present but --version returned nothing" \
        "codex --version"
    fi
  else
    _doctor_fail "E1" "Codex CLI not found on PATH" \
      "npm i -g @openai/codex (need ≥ 0.126.0-alpha.15)"
  fi

  # ── E2 — .codex/config.toml has Sage managed block ──
  if [ -f "$target/.codex/config.toml" ]; then
    if grep -q '# >>> SAGE MANAGED BLOCK START' "$target/.codex/config.toml"; then
      _doctor_pass "E2" ".codex/config.toml has Sage managed block"
    else
      _doctor_fail "E2" ".codex/config.toml missing Sage managed block" \
        "bin/sage update --platform codex"
    fi
  else
    _doctor_fail "E2" ".codex/config.toml absent" \
      "bin/sage init --platform codex"
  fi

  # ── E3 — N/A in v1 (MCP deferred) ──
  _doctor_info "E3" "MCP server reachable — N/A in v1 (deferred per §2 / §8)"

  # ── E4 — Trust state heuristic ──
  if [ -f "$target/.codex/config.toml" ] && \
     grep -q '^developer_instructions' "$target/.codex/config.toml"; then
    _doctor_pass "E4" "developer_instructions block present (trust heuristic OK)"
  else
    _doctor_warn "E4" "developer_instructions not detected — project may not be trusted" \
      "Trust this project in Codex (CLI/UI), then run again"
  fi

  # ── M1 — AGENTS.md matches generated baseline ──
  local fw="${SAGE_FRAMEWORK:-}"
  if [ -z "$fw" ] || [ ! -d "$fw" ]; then
    [ -d "$target/sage" ] && fw="$target/sage"
  fi
  if [ -f "$target/AGENTS.md" ] && [ -n "$fw" ] && [ -d "$fw" ]; then
    local tmpdir tmp_target
    tmpdir="$(mktemp -d -t sage_doctor_baseline.XXXXXX)"
    tmp_target="$tmpdir/baseline"
    mkdir -p "$tmp_target/.codex" "$tmp_target/.sage"
    # Mirror actual project's config inputs so rule-1A variant detection
    # + constitution preset resolution match the project (R3 fix).
    [ -f "$target/.codex/config.toml" ] && cp "$target/.codex/config.toml" "$tmp_target/.codex/config.toml"
    [ -f "$target/.sage/constitution.md" ] && cp "$target/.sage/constitution.md" "$tmp_target/.sage/constitution.md"
    if env SAGE_FRAMEWORK="$fw" \
        "$fw/runtime/platforms/codex/setup/generate-codex.sh" \
        --target "$tmp_target" --preset "${SELECTED_PRESET:-base}" --stage 3 >/dev/null 2>&1; then
      if diff -q "$tmp_target/AGENTS.md" "$target/AGENTS.md" >/dev/null 2>&1; then
        _doctor_pass "M1" "AGENTS.md matches generated baseline"
      else
        _doctor_warn "M1" "AGENTS.md drifted from Sage baseline" \
          "bin/sage update --platform codex"
      fi
    else
      _doctor_warn "M1" "could not regenerate baseline (skipping comparison)" ""
    fi
    rm -rf "$tmpdir"
  else
    _doctor_warn "M1" "AGENTS.md or framework source missing" "bin/sage init --platform codex"
  fi

  # ── M2 — hooks present + executable; jq + yq on PATH ──
  local m2_fail=0
  for h in session-init pre-tool-validate post-tool-check turn-audit; do
    if [ ! -x "$target/.codex/hooks/$h.sh" ]; then
      _doctor_fail "M2" "hook missing/non-executable: .codex/hooks/$h.sh" \
        "bin/sage update --platform codex"
      m2_fail=1
    fi
  done
  for tool in jq yq; do
    if ! command -v "$tool" >/dev/null 2>&1; then
      case "$(uname -s)" in
        Darwin) _doctor_fail "M2" "missing tool: $tool" "brew install $tool" ;;
        Linux)  _doctor_fail "M2" "missing tool: $tool" "apt-get install $tool" ;;
        *)      _doctor_fail "M2" "missing tool: $tool" "install $tool via your package manager" ;;
      esac
      m2_fail=1
    fi
  done
  [ "$m2_fail" -eq 0 ] && _doctor_pass "M2" "4 hooks executable; jq + yq on PATH"

  # ── M3 — sandbox-write hint (v1: hint-only) ──
  _doctor_info "M3" "Codex sandbox must allow .sage/ writes (hint-only in v1)"

  # ── M4 — N/A in v1 ──
  _doctor_info "M4" "Mid-session MCP liveness — N/A in v1 (deferred per §2 / §8)"

  # ── S1 — .mcp-incidents.log unread lines vs cursor ──
  local incidents_log="$target/.sage/.mcp-incidents.log"
  local cursor_file="$target/.sage/.doctor-cursor"
  if [ -f "$incidents_log" ]; then
    local cursor_ts=0
    cursor_ts="$(_doctor_cursor_epoch "$cursor_file")"
    local log_mtime
    log_mtime="$(stat -c '%Y' "$incidents_log" 2>/dev/null || stat -f '%m' "$incidents_log" 2>/dev/null || echo 0)"
    if [ "$log_mtime" -gt "$cursor_ts" ]; then
      local n_unread
      n_unread="$(wc -l < "$incidents_log" | tr -d ' ')"
      _doctor_warn "S1" "$n_unread incident(s) in .sage/.mcp-incidents.log since last doctor run" \
        "Review with: cat .sage/.mcp-incidents.log"
    else
      _doctor_pass "S1" "incidents log clean since last doctor run"
    fi
  else
    _doctor_pass "S1" "no incidents log (clean state)"
  fi

  # ── S2 — N/A in v1 ──
  _doctor_info "S2" "Stale .approval-pending — N/A in v1 (UPS hook deferred)"

  # ── S3 — stale active cycles ──
  local now stale_cycles=""
  now="$(date +%s)"
  local week_secs=$((7 * 86400))
  if [ -d "$target/.sage/work" ]; then
    local cycle
    while IFS= read -r -d '' cycle; do
      local manifest="$cycle/manifest.md"
      [ -f "$manifest" ] || continue
      grep -q '^status:[[:space:]]*in-progress' "$manifest" 2>/dev/null || continue
      local mtime
      mtime="$(stat -c '%Y' "$manifest" 2>/dev/null || stat -f '%m' "$manifest" 2>/dev/null || echo "$now")"
      local age=$((now - mtime))
      if [ "$age" -gt "$week_secs" ]; then
        stale_cycles="${stale_cycles}$(basename "$cycle"), "
      fi
    done < <(find "$target/.sage/work" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null)
  fi
  if [ -n "$stale_cycles" ]; then
    stale_cycles="${stale_cycles%, }"
    _doctor_warn "S3" "stale in-progress cycle(s) > 7d: $stale_cycles" \
      "Resume or close: /sage:continue or /sage:reflect"
  else
    _doctor_pass "S3" "no stale active cycles"
  fi

  # ── S4 — writers manifest cross-reference (closes ADR-7 C7) ──
  # For each .sage/ file mutated in last 20 commits, match against
  # writers manifest pattern (literal path or `<prefix>/**` glob).
  # writers list semantics:
  #   - empty []          → file should not exist in v1 (v2-only)
  #   - contains "agent_via_apply_patch_when_P2_2" → agent commits OK
  #   - hook scripts only → file should never be committed (bypass!)
  local writers_manifest="$target/runtime/platforms/codex/audit/sage-writers.yaml"
  [ -f "$writers_manifest" ] || writers_manifest="$fw/runtime/platforms/codex/audit/sage-writers.yaml"
  if [ ! -f "$writers_manifest" ]; then
    _doctor_info "S4" "writers manifest not found (audit cross-check skipped)"
  elif ! command -v git >/dev/null 2>&1 || ! (cd "$target" && git rev-parse --git-dir >/dev/null 2>&1); then
    _doctor_info "S4" "not a git repo; bypass-write audit skipped"
  elif ! (cd "$target" && git rev-parse HEAD >/dev/null 2>&1); then
    _doctor_info "S4" "no commits yet; bypass-write audit skipped"
  else
    local mutations bypass_files=""
    mutations="$(cd "$target" && git log -n 20 --diff-filter=AM --name-only --pretty=format: -- '.sage/' 2>/dev/null | awk 'NF' | sort -u || true)"
    if [ -z "$mutations" ]; then
      _doctor_pass "S4" "no recent .sage/ mutations to audit"
    else
      while IFS= read -r f; do
        [ -z "$f" ] && continue
        local matched_key=""
        while IFS= read -r key; do
          [ -z "$key" ] && continue
          case "$key" in
            *'/**')
              local prefix="${key%/**}"
              case "$f" in "$prefix"/*) matched_key="$key"; break ;; esac
              ;;
            *)
              [ "$f" = "$key" ] && { matched_key="$key"; break; } ;;
          esac
        done < <(yq eval 'keys | .[]' "$writers_manifest" 2>/dev/null)
        [ -z "$matched_key" ] && continue
        local writers
        writers="$(yq eval ".[\"$matched_key\"].writers[]" "$writers_manifest" 2>/dev/null)"
        if [ -z "$writers" ]; then
          bypass_files="${bypass_files}$f (v2-only), "
        elif echo "$writers" | grep -q 'agent_via_apply_patch_when_P2_2'; then
          continue
        else
          bypass_files="${bypass_files}$f (hook-only writer), "
        fi
      done <<< "$mutations"
      if [ -n "$bypass_files" ]; then
        _doctor_warn "S4" "bypass-write detected: ${bypass_files%, }" \
          "Investigate which writer mutated these paths"
      else
        local n
        n="$(echo "$mutations" | wc -l | tr -d ' ')"
        _doctor_pass "S4" "writers manifest cross-check OK ($n .sage/ file(s) audited)"
      fi
    fi
  fi

  # ── S5 — documentation routing hygiene ──
  local actionable_docs=""
  if [ -d "$target/.sage/docs" ]; then
    local doc
    while IFS= read -r -d '' doc; do
      local base
      base="$(basename "$doc")"
      if printf '%s\n' "$base" | grep -qiE '(todo|task|backlog|follow-?up|action)'; then
        actionable_docs="${actionable_docs}$base, "
        continue
      fi
      if grep -qiE '(^|[[:space:]])(- \[[ xX]?\]|TODO|FIXME|follow-?up|actionable|next action|backlog)' "$doc" 2>/dev/null; then
        actionable_docs="${actionable_docs}$base, "
      fi
    done < <(find "$target/.sage/docs" -maxdepth 1 -type f -name '*.md' -print0 2>/dev/null)
  fi
  if [ -n "$actionable_docs" ]; then
    actionable_docs="${actionable_docs%, }"
    _doctor_warn "S5" "possible actionable work in .sage/docs: $actionable_docs" \
      "Route actionable work to .sage/work/<cycle>/manifest.md or a minimal intake cycle"
  else
    _doctor_pass "S5" "no actionable docs routing warnings"
  fi

  # ── S6 — recovery-first safe auto-fix audit ──
  local autofix_log="$target/.sage/.auto-fixes.log"
  if [ -s "$autofix_log" ]; then
    local n_autofixes
    n_autofixes="$(wc -l < "$autofix_log" | tr -d ' ')"
    _doctor_info "S6" "$n_autofixes safe auto-fix audit entr$( [ "$n_autofixes" = "1" ] && printf 'y' || printf 'ies' ) in .sage/.auto-fixes.log" \
      "Review with: cat .sage/.auto-fixes.log"
  else
    _doctor_pass "S6" "no safe auto-fix audit entries"
  fi

  # ── CV1 — Codex version watch ──
  local validated_file="$target/.sage/.codex-validated-version"
  if [ -n "$codex_ver" ] && [ -f "$validated_file" ]; then
    local validated
    validated="$(cat "$validated_file" 2>/dev/null)"
    if [ "$validated" = "$codex_ver" ]; then
      _doctor_pass "CV1" "Codex version matches validated record ($validated)"
    else
      _doctor_warn "CV1" "Codex version changed: $validated → $codex_ver" \
        "Re-validate: /sage:learn or update .sage/.codex-validated-version"
    fi
  else
    _doctor_info "CV1" "no validated version recorded yet (informational)"
  fi

  # ── Summary + cursor write ──
  echo ""
  echo -e "  ${BOLD}Summary:${RESET} ${GREEN}$pass_n ok${RESET}, ${YELLOW}$warn_n warn${RESET}, ${RED}$fail_n fail${RESET}"
  echo ""

  # Update doctor cursor (the only file doctor writes).
  mkdir -p "$target/.sage"
  cursor_epoch="$(date +%s)"
  cursor_iso="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  if command -v jq >/dev/null 2>&1; then
    jq -nc --arg ts "$cursor_iso" --arg source ".sage/.mcp-incidents.log" --argjson epoch "$cursor_epoch" \
      '{kind:"doctor_cursor", last_checked_at:$ts, last_checked_epoch:$epoch, source:$source}' \
      > "$target/.sage/.doctor-cursor"
  else
    printf '{"kind":"doctor_cursor","last_checked_at":"%s","last_checked_epoch":%s,"source":".sage/.mcp-incidents.log"}\n' \
      "$cursor_iso" "$cursor_epoch" > "$target/.sage/.doctor-cursor"
  fi

  [ "$fail_n" -eq 0 ]
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: status (disk-direct, no MCP — per spec §7.3 + ADR-9 v1)
# ═══════════════════════════════════════════════════════════════
# Read one scalar from YAML frontmatter. Falls back to flat YAML manifests for
# older artifacts, but delimited frontmatter never scans the markdown body.
status_manifest_field() {
  local file="$1"
  local key="$2"
  awk -v key="$key" '
    BEGIN { in_yaml = 0; delimited = 0; pattern = "^" key ":[[:space:]]*" }
    NR == 1 && $0 == "---" { in_yaml = 1; delimited = 1; next }
    delimited && in_yaml && $0 == "---" { exit }
    !delimited { in_yaml = 1 }
    in_yaml && $0 ~ pattern {
      sub(pattern, "")
      sub(/^[[:space:]]*/, "")
      sub(/[[:space:]]*$/, "")
      gsub(/^"|"$/, "")
      gsub(/^'\''|'\''$/, "")
      print
      exit
    }
  ' "$file"
}

# Plain text by default; --json for scriptable form.
# 4 blocks: active cycles | pending gates | recent decisions | health.
sage_status() {
  local target
  target="$(pwd)"
  local json_mode=0

  for arg in "$@"; do
    case "$arg" in
      --json) json_mode=1 ;;
      *) ;;
    esac
  done

  if [ ! -d "$target/.sage" ]; then
    if [ "$json_mode" -eq 1 ]; then
      printf '{"error":"no .sage/ directory","cycles":[],"gates":[],"decisions":[],"health":{}}\n'
    else
      echo ""
      echo -e "  ${RED}❌ No .sage/ directory in this project.${RESET}"
      echo "  Najpierw uruchom 'sage init'."
    fi
    exit 1
  fi

  # ── Read cycles from .sage/work/<id>/manifest.md ──
  # Each cycle is derived from manifest frontmatter only.
  local cycles_json=""
  local active_cycles_json=""
  local parked_cycles_json=""
  local counts_by_status="{}"
  local counts_by_resolution="{}"
  local cycle
  while IFS= read -r -d '' cycle; do
    local manifest="$cycle/manifest.md"
    [ -f "$manifest" ] || continue
    local id cycle_id title workflow phase status priority owner updated resolution folded_into active_session_id
    id="$(basename "$cycle")"
    cycle_id="$(status_manifest_field "$manifest" cycle_id)"
    title="$(status_manifest_field "$manifest" title)"
    workflow="$(status_manifest_field "$manifest" workflow)"
    phase="$(status_manifest_field "$manifest" phase)"
    status="$(status_manifest_field "$manifest" status)"
    priority="$(status_manifest_field "$manifest" priority)"
    owner="$(status_manifest_field "$manifest" owner)"
    updated="$(status_manifest_field "$manifest" updated)"
    resolution="$(status_manifest_field "$manifest" resolution)"
    folded_into="$(status_manifest_field "$manifest" folded_into)"
    active_session_id="$(status_manifest_field "$manifest" active_session_id)"
    [ -n "$cycle_id" ] || cycle_id="$id"
    case "$status" in
      "") status="in-progress" ;;
      completed|complete|rejected-superseded) status="closed" ;;
    esac
    counts_by_status="$(jq -c --arg status "$status" '.[$status] = (.[$status] // 0) + 1' <<< "$counts_by_status")"
    if [ -n "$resolution" ]; then
      counts_by_resolution="$(jq -c --arg resolution "$resolution" '.[$resolution] = (.[$resolution] // 0) + 1' <<< "$counts_by_resolution")"
    fi
    case "$status" in
      in-progress|in_progress|active|paused|intake) ;;
      *) continue ;;
    esac
    local entry
    entry="$(jq -n \
      --arg id "$id" --arg cycle_id "$cycle_id" --arg title "$title" \
      --arg workflow "$workflow" --arg phase "$phase" --arg status "$status" \
      --arg priority "$priority" --arg owner "$owner" --arg updated "$updated" \
      --arg resolution "$resolution" --arg folded_into "$folded_into" \
      --arg active_session_id "$active_session_id" \
      '{id: $id, cycle_id: $cycle_id, title: $title, workflow: $workflow, phase: $phase, status: $status, priority: $priority, owner: $owner, updated: $updated, resolution: $resolution, folded_into: $folded_into, active_session_id: $active_session_id}')"
    if [ -z "$cycles_json" ]; then
      cycles_json="$entry"
    else
      cycles_json="${cycles_json},${entry}"
    fi
    case "$status" in
      in-progress|in_progress|active)
        [ -z "$active_cycles_json" ] && active_cycles_json="$entry" || active_cycles_json="${active_cycles_json},${entry}" ;;
      paused|intake)
        [ -z "$parked_cycles_json" ] && parked_cycles_json="$entry" || parked_cycles_json="${parked_cycles_json},${entry}" ;;
    esac
  done < <(find "$target/.sage/work" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null | sort -z)

  # ── Pending gates ──
  # v1: approval-detection layer DEFERRED to v2 per spec §6.2 (Cut A,
  # 2026-04-30). v1 has no canonical mechanism to know which cycles
  # await [A] — UPS hook + .approval-pending token deferred. Doing
  # keyword grep here would re-introduce the deferred surface and
  # violate brief Hard Anti-Pattern ("no keyword classification, in
  # any language"). v1 stance: block exists for spec §7.3 conformance,
  # always empty, rendered with explicit deferred-to-v2 hint.
  local gates_json=""

  # ── Last 3 decisions from .sage/decisions.md ──
  local decisions_json="[]"
  if [ -f "$target/.sage/decisions.md" ]; then
    if command -v decisions_recent_json >/dev/null 2>&1; then
      decisions_json="$(decisions_recent_json "$target/.sage/decisions.md" 3)"
    fi
  fi

  # ── Health summary: short doctor (just counts) ──
  # Re-derive from the same checks as sage_doctor would, in lightweight form.
  local h_pass=0 h_warn=0 h_fail=0
  command -v codex >/dev/null 2>&1 && h_pass=$((h_pass + 1)) || h_fail=$((h_fail + 1))
  if [ -f "$target/.codex/config.toml" ] && \
     grep -q '# >>> SAGE MANAGED BLOCK START' "$target/.codex/config.toml"; then
    h_pass=$((h_pass + 1))
  else
    h_fail=$((h_fail + 1))
  fi
  for h in session-init pre-tool-validate post-tool-check turn-audit; do
    if [ -x "$target/.codex/hooks/$h.sh" ]; then
      h_pass=$((h_pass + 1))
    else
      h_fail=$((h_fail + 1))
    fi
  done
  for tool in jq yq; do
    command -v "$tool" >/dev/null 2>&1 && h_pass=$((h_pass + 1)) || h_fail=$((h_fail + 1))
  done

  if [ "$json_mode" -eq 1 ]; then
    jq -n \
      --argjson cycles "[${cycles_json}]" \
      --argjson counts_by_status "$counts_by_status" \
      --argjson counts_by_resolution "$counts_by_resolution" \
      --argjson gates "[${gates_json}]" \
      --argjson decisions "$decisions_json" \
      --argjson health "{\"pass\":$h_pass,\"warn\":$h_warn,\"fail\":$h_fail}" \
      '{work_index: {cycles: $cycles, counts: {by_status: $counts_by_status, by_resolution: $counts_by_resolution}}, cycles: $cycles, gates: $gates, recent_decisions: $decisions, decisions: $decisions, health: $health}'
    return 0
  fi

  # ── Plain text output ──
  echo ""
  echo -e "  ${BOLD}Sage status${RESET}"
  echo ""

  echo -e "  ${BOLD}Aktywne cykle${RESET}"
  if [ -z "$active_cycles_json" ]; then
    echo -e "    ${DIM}(none)${RESET}"
  else
    echo "[${active_cycles_json}]" | jq -r '.[] | "    • \(.id)  \(.title)  [\(.workflow)/\(.phase)]  status=\(.status)  updated=\(.updated)"'
  fi
  echo ""

  echo -e "  ${BOLD}Zaparkowane / intake${RESET}"
  if [ -z "$parked_cycles_json" ]; then
    echo -e "    ${DIM}(none)${RESET}"
  else
    echo "[${parked_cycles_json}]" | jq -r '.[] | "    • \(.id)  \(.title)  [\(.workflow)/\(.phase)]  status=\(.status)  updated=\(.updated)  zaparkowane manifest-only; brak aktywnej implementacji; next: sage:continue albo jawne resume tego cyklu"'
  fi
  echo ""

  echo -e "  ${BOLD}Bramki pending${RESET}"
  echo -e "    ${DIM}(brak — approval-detection deferred to v2 per spec §6.2)${RESET}"
  echo ""

  echo -e "  ${BOLD}Ostatnie decyzje${RESET}"
  if [ "$decisions_json" = "[]" ]; then
    echo -e "    ${DIM}(none)${RESET}"
  else
    echo "$decisions_json" | jq -r '.[] | "    • \(.date) — \(.title)"'
  fi
  echo ""

  echo -e "  ${BOLD}Zdrowie${RESET}  ${GREEN}$h_pass ok${RESET}, ${YELLOW}$h_warn warn${RESET}, ${RED}$h_fail fail${RESET}  ${DIM}(szczegóły: 'sage doctor')${RESET}"
  echo ""
}

sage_skills() {
  skill_manager list "$@"
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: setup
# ═══════════════════════════════════════════════════════════════
sage_setup() {
  local component="${1:-}"

  if [ "$component" != "memory" ]; then
    echo ""
    echo -e "  ${BOLD}Sage — Setup${RESET}"
    echo ""
    echo "  Usage: sage setup memory"
    echo ""
    return
  fi

  echo ""
  echo -e "  ${BOLD}Sage — Setup Memory${RESET}"
  echo ""
  echo "  sage-memory gives your AI agent persistent knowledge across sessions."
  echo "  It remembers architecture decisions, conventions, debugging insights,"
  echo "  and project patterns — so the agent never starts from scratch."
  echo ""
  echo -e "  ${BOLD}Step 1:${RESET} Add to your MCP config"
  echo ""

  # Detect platform
  # Codex MCP hint removed in v1 (spec §7.1): v1 ships no MCP server
  # per §2 / §8 decision 2026-04-30. Returns when v2 reactivates MCP.
  if [ -d ".claude" ] || [ -f "$HOME/.claude.json" ]; then
    echo -e "  ${CYAN}Claude Code${RESET} — add to ~/.claude.json:"
    echo ""
    echo '  {'
    echo '    "mcpServers": {'
    echo '      "sage-memory": {'
    echo '        "command": "uvx",'
    echo '        "args": ["sage-memory"]'
    echo '      }'
    echo '    }'
    echo '  }'
  elif [ -d ".cursor" ]; then
    echo -e "  ${CYAN}Cursor${RESET} — add to .cursor/mcp.json:"
    echo ""
    echo '  {'
    echo '    "mcpServers": {'
    echo '      "sage-memory": {'
    echo '        "command": "uvx",'
    echo '        "args": ["sage-memory"]'
    echo '      }'
    echo '    }'
    echo '  }'
  else
    echo "  Add to your MCP client config:"
    echo ""
    echo '  {'
    echo '    "mcpServers": {'
    echo '      "sage-memory": {'
    echo '        "command": "uvx",'
    echo '        "args": ["sage-memory"]'
    echo '      }'
    echo '    }'
    echo '  }'
  fi

  echo ""
  echo -e "  ${BOLD}Step 2:${RESET} Restart your IDE"
  echo ""
  echo "  That's it. Sage will automatically search and store knowledge"
  echo "  as you work. No configuration needed."
  echo ""
  echo -e "  ${DIM}Requires uv: curl -LsSf https://astral.sh/uv/install.sh | sh${RESET}"
  echo -e "  ${DIM}More info: https://github.com/xoai/sage-memory${RESET}"
  echo ""
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: learn
# ═══════════════════════════════════════════════════════════════
sage_learn() {
  local target="${1:-.}"

  echo ""
  echo -e "  ${BOLD}Sage — Learn${RESET}"
  echo ""

  # Check if we're in a Sage project
  if [ ! -d "sage/skills" ] && [ ! -d ".sage" ]; then
    echo -e "  ${RED}❌ No Sage project found here.${RESET}"
    echo "  Run this from a Sage project directory."
    exit 1
  fi

  if [ "$target" = "." ]; then
    echo -e "  ${CYAN}Broad scan:${RESET} learning the whole project"
  else
    if [ ! -e "$target" ]; then
      echo -e "  ${RED}❌ Target not found: $target${RESET}"
      exit 1
    fi
    echo -e "  ${CYAN}Deep dive:${RESET} $target"
  fi

  echo ""
  echo "  This command works inside your AI agent (Claude Code, Antigravity, Codex)."
  echo "  Open this project in your IDE, then tell the agent:"
  echo ""

  if [ "$target" = "." ]; then
    echo -e "    ${BOLD}\"Learn this project. Do a broad scan and store${RESET}"
    echo -e "    ${BOLD} what you learn in memory.\"${RESET}"
  else
    echo -e "    ${BOLD}\"Learn $target. Do a deep dive and store${RESET}"
    echo -e "    ${BOLD} what you learn in memory.\"${RESET}"
  fi

  echo ""
  echo "  The agent will follow the memory skill\'s learn workflow:"
  echo "    1. Scan structure and key files"
  echo "    2. Identify patterns, conventions, architecture"
  echo "    3. Store focused memories in sage-memory"
  echo "    4. Generate knowledge report → .sage/docs/memory-{name}.md"
  echo ""
  echo -e "  ${DIM}Requires sage-memory MCP server. Setup: https://github.com/xoai/sage-memory${RESET}"
  echo ""
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: help
# ═══════════════════════════════════════════════════════════════
sage_help() {
  echo ""
  echo -e "${BOLD}Sage${RESET} — An intelligent skills framework for AI agents"
  echo ""
  echo "Project commands:"
  echo "  sage new <n>                  Create a new project with Sage"
  echo "  sage init [--prefix]          Add Sage to the current directory"
  echo "  sage update                   Regenerate platform files"
  echo "  sage upgrade                  Update Sage to the latest version"
  echo "  sage learn [path]             Learn a codebase or module"
  echo "  sage doctor                   Diagnose Codex port (read-only)"
  echo "  sage status [--json]          Show active cycles, pending gates, decisions, health"
  echo "  sage setup memory             Configure persistent memory"
  echo ""
  echo "Skill management (powered by skills.sh):"
  echo "  sage find <query>                Search skills.sh catalog"
  echo "  sage add <source>                Install skills from owner/repo, URL, or path"
  echo "  sage add <source> --skill <n>    Install a specific skill from a repo"
  echo "  sage add <source> --all          Install all skills from a repo"
  echo "  sage remove <skill>              Remove a skill from project"
  echo "  sage skills                      List installed skills"
  echo "  sage update [target]             Update community skills"
  echo ""
  echo "  sage help                        Show this help"
  echo ""
  echo "Flags:"
  echo "  --prefix                         Namespace commands as sage:build, sage:fix, etc."
  echo "  --preset <name>                  Set constitution preset (base|startup|enterprise|opensource)"
  echo "  --platform <names>               claude-code, antigravity, codex, or comma-separated combinations"
  echo "  --self-host                      Reuse the local framework checkout in place (framework repo only)"
  echo ""
  echo "Examples:"
  echo "  sage new my-app --platform codex                  # Create a Codex-native Sage project"
  echo "  sage init --platform claude-code,codex --prefix   # Add Sage for Claude Code + Codex"
  echo "  sage init --self-host --platform claude-code,codex # Self-host the framework repo on this branch"
  echo "  sage learn                                        # Broad scan of whole project"
  echo "  sage learn src/billing/                           # Deep dive into a module"
  echo "  sage find react                                   # Search skills.sh for React skills"
  echo "  sage add vercel-labs/agent-skills               # Browse + pick skills"
  echo "  sage add vercel-labs/agent-skills --skill react  # Install specific skill"
  echo "  sage add ./my-local-skills                      # Install from local path"
  echo ""
}

# ═══════════════════════════════════════════════════════════════
# MAIN
# ═══════════════════════════════════════════════════════════════
COMMAND="${1:-}"
shift 2>/dev/null || true

# Parse flags from remaining args
PRESET_FLAG=""
PLATFORM_FLAG=""
PREFIX_FLAG=""
SELF_HOST_FLAG=""
REMAINING_ARGS=()
for arg in "$@"; do
  case "$arg" in
    --preset=*) PRESET_FLAG="${arg#--preset=}" ;;
    --preset)   PRESET_FLAG="__NEXT__" ;;
    --platform=*) PLATFORM_FLAG="${arg#--platform=}" ;;
    --platform)  PLATFORM_FLAG="__NEXT__" ;;
    --prefix)   PREFIX_FLAG="true" ;;
    --self-host) SELF_HOST_FLAG="true" ;;
    *)
      if [ "$PRESET_FLAG" = "__NEXT__" ]; then
        PRESET_FLAG="$arg"
      elif [ "$PLATFORM_FLAG" = "__NEXT__" ]; then
        PLATFORM_FLAG="$arg"
      else
        REMAINING_ARGS+=("$arg")
      fi
      ;;
  esac
done
set -- ${REMAINING_ARGS[@]+"${REMAINING_ARGS[@]}"}

case "$COMMAND" in
  new)              sage_new "$@" ;;
  init)             sage_init ;;
  update)           sage_update ;;
  upgrade)          sage_upgrade ;;
  doctor)           sage_doctor "$@" ;;
  status)           sage_status "$@" ;;
  learn)            sage_learn "$@" ;;
  setup)            sage_setup "$@" ;;
  find)             sage_find "$@" ;;
  add)              sage_add "$@" ;;
  remove)           sage_remove "$@" ;;
  skills)           sage_skills "$@" ;;
  help|--help|-h)   sage_help ;;
  "")               sage_help ;;
  *)
    echo -e "${RED}Unknown command: $COMMAND${RESET}"
    sage_help
    exit 1
    ;;
esac
