#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════
# bin/sage-install-hooks
#
# Thin wrapper around `bin/sage install-hooks`. Kept as the
# sanctioned standalone entry point per the README "Repo hooks"
# section, but the actual logic lives in bin/sage so the two cannot
# drift.
#
# Why a wrapper instead of duplicated logic:
#   The install procedure (hook copy + sha256 preservation +
#   core.hooksPath wire) lives in bin/sage's ensure_hooks_wired().
#   Sourcing it via this script ensures one source of truth.
#
# Usage:
#   bin/sage-install-hooks
# ═══════════════════════════════════════════════════════════════
set -euo pipefail

# Resolve the script's real directory, following symlinks. Users often
# symlink CLIs from ~/bin/ → framework/bin/; without symlink resolution,
# $HERE points at ~/bin/ where bin/sage does not exist.
SELF="$0"
if command -v readlink >/dev/null 2>&1; then
  # GNU readlink supports -f; macOS readlink does not until coreutils.
  RESOLVED="$(readlink -f "$SELF" 2>/dev/null || true)"
  if [ -z "$RESOLVED" ]; then
    # macOS fallback: walk symlinks one at a time.
    RESOLVED="$SELF"
    while [ -L "$RESOLVED" ]; do
      LINK="$(readlink "$RESOLVED")"
      case "$LINK" in
        /*) RESOLVED="$LINK" ;;
        *)  RESOLVED="$(dirname "$RESOLVED")/$LINK" ;;
      esac
    done
  fi
  SELF="$RESOLVED"
fi
HERE="$(cd "$(dirname "$SELF")" && pwd)"
SAGE_BIN="$HERE/sage"

if [ ! -x "$SAGE_BIN" ]; then
  echo "Sage: framework entry point bin/sage not found alongside this script." >&2
  echo "Sage: looked at $SAGE_BIN" >&2
  echo "Sage: this script must ship from the same directory as bin/sage." >&2
  exit 1
fi

exec "$SAGE_BIN" install-hooks
