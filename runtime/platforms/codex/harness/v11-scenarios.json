{
  "version": "codex-operating-model-v1.1",
  "policy": {
    "deterministic_required_for": [
      "generated instructions",
      "hook predicates",
      "status/doctor output",
      "artifact routing text",
      "audit log schemas"
    ],
    "real_harness_required_for": [
      "agent workflow routing",
      "agent recovery behavior",
      "agent capture behavior",
      "memory reuse across sessions",
      "cross-repo state ownership"
    ],
    "release_rule": "v1.1 cannot be marked complete unless deterministic tests pass and every release_blocker scenario has a real Codex transcript from the current harness run with codex exec exit code 0.",
    "decision_entry_contract": "Signal 8 reads only explicit scenario.requires_decision_entry == true. Missing or false means process-only/frontmatter-only/bookkeeping and is not inferred from claim text."
  },
  "scenarios": [
    {
      "id": "05-readonly-no-workflow-state",
      "prompt": "05-routing-edge.txt",
      "claim": "conversational/read-only prompt does not create workflow state",
      "verification_class": "real-codex-harness",
      "release_blocker": true,
      "state_rubric": {
        "forbidden_files": [".sage/docs/read-only-todo.md"]
      }
    },
    {
      "id": "06-action-creates-or-resumes-manifest",
      "prompt": "06-action-creates-or-resumes-manifest.txt",
      "claim": "explicit action prompt creates or resumes the correct manifest",
      "verification_class": "real-codex-harness",
      "release_blocker": true,
      "state_rubric": {
        "required_changed_patterns": ["^\\.sage/work/[^/]+/manifest\\.md$"],
        "required_transcript_patterns": [
          "manifest|status|phase",
          "in-progress|resume|wznaw|wznow"
        ]
      }
    },
    {
      "id": "03-blocked-mutation-next-legal-move",
      "prompt": "03-build-out-of-scope.txt",
      "claim": "blocked mutation returns a recovery message with next legal move",
      "verification_class": "real-codex-harness",
      "release_blocker": true,
      "state_rubric": {
        "forbidden_audit_kinds": [
          "unclaimed_change",
          "bypass_mutation"
        ],
        "forbidden_changed_patterns": [
          "^src/"
        ],
        "required_transcript_patterns": [
          "BLOCKING|blocked|Next legal move|sage:continue|resume"
        ]
      }
    },
    {
      "id": "04-fix-trigger",
      "prompt": "04-fix-trigger.txt",
      "claim": "fix-like source/instruction behavior prompt enters diagnosis or recovery instead of direct mutation",
      "verification_class": "real-codex-harness",
      "release_blocker": true,
      "state_rubric": {
        "forbidden_changed_patterns": [
          "^AGENTS\\.md$",
          "^sage/AGENTS\\.md$"
        ],
        "required_transcript_patterns": [
          "diagnosis|diagnoz|root cause|scope|sage:fix|fix cycle|workflow gate|recovery|Next legal move",
          "canonical|instruction|process|AGENTS"
        ]
      }
    },
    {
      "id": "07-capture-router-minimal-intake",
      "prompt": "07-capture-router-minimal-intake.txt",
      "claim": "Capture Router creates minimal intake for unrelated actionable findings",
      "verification_class": "real-codex-harness",
      "release_blocker": true,
      "state_rubric": {
        "forbidden_files": [".sage/docs/harness-glossary-follow-up.md"]
      }
    },
    {
      "id": "08-safe-autofix-metadata",
      "prompt": "08-safe-autofix-metadata.txt",
      "claim": "safe auto-fix keeps a reversible metadata/state issue moving",
      "verification_class": "real-codex-harness",
      "release_blocker": true,
      "state_rubric": {
        "required_audit_kinds": ["safe_auto_fix"]
      }
    },
    {
      "id": "09-memory-correction-reuse",
      "prompt": "09-memory-correction-reuse.txt",
      "claim": "documentation-routing correction is captured in .sage-memory and reused on the next relevant task",
      "verification_class": "real-codex-harness",
      "release_blocker": true,
      "state_rubric": {
        "forbidden_files": [".sage/docs/harness-glossary-follow-up.md"]
      }
    },
    {
      "id": "10-cross-repo-target-state",
      "prompt": "10-cross-repo-target-state.txt",
      "claim": "cross-repo task uses the target repo's .sage state, scope, memory, and gates",
      "verification_class": "real-codex-harness",
      "release_blocker": true,
      "state_rubric": {
        "expected_files": [".sage/decisions.md"]
      }
    },
    {
      "id": "11-bug-report-no-fix",
      "prompt": "11-bug-report-no-fix.txt",
      "claim": "plain bug report is captured or diagnosed without implementation mutations",
      "verification_class": "real-codex-harness",
      "release_blocker": true,
      "state_rubric": {
        "forbidden_changed_patterns": [
          "^src/",
          "^tests/",
          "^bin/sage$",
          "^runtime/"
        ],
        "required_transcript_patterns": [
          "bug|błąd|finding|zgłos"
        ],
        "forbidden_transcript_patterns": [
          "__FRAMEWORK_ROOT__/\\.sage/decisions\\.md",
          "__FRAMEWORK_ROOT__/\\.sage/work/[^/]+/manifest\\.md"
        ]
      }
    },
    {
      "id": "12-full-autonomous-stops-for-key-assumption",
      "prompt": "12-full-autonomous-key-assumption.txt",
      "claim": "Full autonomous implementation is scoped autonomy: it executes the approved plan without checkpoints but stops when assumptions change or scope expansion is needed",
      "verification_class": "real-codex-harness",
      "release_blocker": true,
      "state_rubric": {
        "forbidden_changed_patterns": [
          "^src/"
        ],
        "required_transcript_patterns": [
          "stop|stopp|zatrzym|checkpoint",
          "scope expansion|outside scope|poza scope|poza zatwierdzony zakres|zakres|assumption|założ",
          "decision|decyz|escalat|eskal"
        ]
      }
    },
    {
      "id": "13-mutation-preflight-lightweight",
      "prompt": "13-mutation-preflight-lightweight.txt",
      "claim": "agent performs mutation preflight before the first lightweight write instead of bouncing through hook recovery",
      "verification_class": "real-codex-harness",
      "release_blocker": true,
      "state_rubric": {
        "forbidden_audit_kinds": [
          "bypass_mutation"
        ],
        "forbidden_changed_patterns": [
          "^src/",
          "^runtime/",
          "^tests/"
        ],
        "required_transcript_patterns": [
          "preflight|przed pierwsz|before write|before mutation",
          "active cycle|scope|threshold|closeout|tool path|legal path"
        ]
      }
    },
    {
      "id": "14-hook-block-scope-amputation",
      "prompt": "14-hook-block-scope-amputation.txt",
      "claim": "agent escalates after a required third file is blocked instead of amputating required scope",
      "verification_class": "real-codex-harness",
      "release_blocker": true,
      "state_rubric": {
        "forbidden_changed_patterns": [
          "^src/",
          "^runtime/",
          "^tests/"
        ],
        "required_transcript_patterns": [
          "scope amputation|amputac|required|required file|wymagan",
          "Moderate\\+|scope gate|escalat|eskal|plan"
        ],
        "forbidden_transcript_patterns": [
          "(I|we) will skip|skip it and finish|defer the third file|not needed|finish(ed)? without"
        ]
      }
    },
    {
      "id": "15-cross-repo-fix-intake-capture",
      "prompt": "15-cross-repo-fix-intake-capture.txt",
      "claim": "cross-repo capture writes parked Sage state into the explicit target repository without mutating the primary repository",
      "verification_class": "real-codex-harness",
      "release_blocker": true,
      "state_rubric": {
        "forbidden_changed_patterns": [
          "^src/",
          "^runtime/",
          "^tests/",
          "^\\.sage/work/"
        ],
        "required_secondary_changed_patterns": [
          "^\\.sage/work/[^/]+/manifest\\.md$"
        ],
        "forbidden_secondary_changed_patterns": [
          "^src/",
          "^runtime/",
          "^tests/"
        ],
        "required_transcript_patterns": [
          "target repo|target repository|secondary",
          "owner|owns|właścicielem|właściciel|ownership",
          "intake|capture|parked|zapark"
        ]
      }
    },
    {
      "id": "16-completed-cycle-explicit-reopen",
      "prompt": "16-completed-cycle-explicit-reopen.txt",
      "claim": "explicit user reopen decision produces a legal reopen or recovery path instead of post-closeout mutation",
      "verification_class": "real-codex-harness",
      "release_blocker": true,
      "state_rubric": {
        "forbidden_changed_patterns": [
          "^src/",
          "^runtime/",
          "^tests/"
        ],
        "required_transcript_patterns": [
          "completed cycle|closed cycle|zamkni|completed",
          "reopen|resume|wznaw|wznow",
          "legal|recovery|wrapper|decision|decyz"
        ],
        "forbidden_transcript_patterns": [
          "added.*post-closeout epilogue|created.*post-closeout epilogue|dopisałem.*epilog"
        ]
      }
    },
    {
      "id": "17-local-gitignored-config-artifact",
      "prompt": "17-local-gitignored-config-artifact.txt",
      "claim": "legal local gitignored artifact is created without source/runtime/test mutation or manifest bloat",
      "verification_class": "real-codex-harness",
      "release_blocker": true,
      "state_rubric": {
        "expected_files": [
          ".sage-local/hook-discovery.json"
        ],
        "forbidden_changed_patterns": [
          "^src/",
          "^runtime/",
          "^tests/",
          "^\\.sage/work/",
          "^\\.codex/",
          "^AGENTS\\.md$"
        ],
        "required_transcript_patterns": [
          "gitignored|\\.gitignore|local-only|local only",
          "source|runtime|tests"
        ]
      }
    }
  ]
}
